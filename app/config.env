# Settings shared by the app build scripts and the publish guard.
# The publish guard (guard/cartouche_guard/__init__.py) must use the same bundle identifier.
CARTOUCHE_BUNDLE_ID=io.github.clabeuhtegrite.cartouche
CARTOUCHE_DISPLAY_NAME=Cartouche

# Cartouche's own version, major.minor.patch, in place of LiveContainer's.
# Cartouche offers an update, which its built-in SideStore installs, when its
# source (app/sidestore-source.json) lists a higher one than the version
# installed, so every release raises it.
CARTOUCHE_VERSION=0.16.0

# Cartouche's own names in the LiveContainer and SideStore sources, applied by
# app/scripts/brand.py. The built-in SideStore answers "sidestore." plus the
# URL scheme. The app group and the keychain groups stay LiveContainer+
# SideStore's, so that iloader gives Cartouche its certificate.
CARTOUCHE_URL_SCHEME=cartouche
# The source the built-in SideStore reads, and Cartouche too to offer its
# updates: Cartouche itself, and nothing else.
CARTOUCHE_SIDESTORE_SOURCE_URL=https://raw.githubusercontent.com/clabeuhtegrite/Cartouche/main/app/sidestore-source.json
# The source a player adds to their own SideStore to install Cartouche
# without a computer: the IPA for the player's SideStore of each version
# (app/scripts/sidestore_ipa.py, docs/decisions/147.md), which has its own app
# group. Cartouche installed from it, and its built-in SideStore, read it
# for its updates in place of the one above. It is at the project's domain:
# the Showcase site workflow publishes app/sidestore-player-source.json there
# whenever it changes on main (.github/workflows/site.yml, decision 155).
CARTOUCHE_PLAYER_SIDESTORE_SOURCE_URL=https://cartouche.cloud/sidestore.json
# The games' covers Cartouche reads every day, over those its catalog
# carries: the Live covers workflow keeps them on the branch live-covers,
# with the games nxnative added since the pinned commit. IGDB's IDs only
# (catalog/README.md).
CARTOUCHE_COVERS_URL=https://raw.githubusercontent.com/clabeuhtegrite/Cartouche/refs/heads/live-covers/covers.json

# The telemetry server Cartouche sends its game measurements and events to
# (telemetry/README.md, docs/privacy.md): the address of the Worker the
# Telemetry workflow deploys, https only, at the project's domain since
# decision 158; a Cartouche built before sends to its former address, which
# relays to this one. Empty, Cartouche keeps its reports on the iPhone and
# sends nothing.
CARTOUCHE_TELEMETRY_URL=https://telemetry.cartouche.cloud
