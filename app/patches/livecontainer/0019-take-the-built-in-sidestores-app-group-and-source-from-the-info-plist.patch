diff --git a/SideStoreSupport/SideStoreHooks.m b/SideStoreSupport/SideStoreHooks.m
index f9932ae..ae98d5c 100644
--- a/SideStoreSupport/SideStoreHooks.m
+++ b/SideStoreSupport/SideStoreHooks.m
@@ -79,7 +79,10 @@ static id SSSceneObserver;
 }
 
 + (NSString*)hook_baseAltStoreAppGroupID {
-    return @"group.com.SideStore.SideStore";
+    // Cartouche: the group of the IPA for the player's own SideStore, when
+    // it is that one, so that the built-in SideStore signs Cartouche again
+    // with it, never with the player's SideStore's.
+    return LCSharedUtils.builtInSideStoreAppGroup;
 }
 
 + (NSBundle*)hook_activeBundle {
@@ -99,7 +102,17 @@ NSURL* SideStoreSource_hook_altStoreSourceURL(id self, SEL cmd) {
     static NSURL* sourceURL = nil;
     static dispatch_once_t onceToken;
     dispatch_once(&onceToken, ^{
-        sourceURL = [NSURL URLWithString:@"https://github.com/LiveContainer/LiveContainer/releases/download/1.0/apps_ss_lc.json"];
+        // Cartouche: the source its Info.plist names, which the IPA for the
+        // player's own SideStore changes for its own (CartoucheSourceURL,
+        // app/scripts/sidestore_ipa.py), https only, else the one the app is
+        // built with.
+        NSString *named = LCSharedUtils.cartoucheAppInfo[@"CartoucheSourceURL"];
+        if ([named isKindOfClass:NSString.class] && [named hasPrefix:@"https://"]) {
+            sourceURL = [NSURL URLWithString:named];
+        }
+        if (!sourceURL) {
+            sourceURL = [NSURL URLWithString:@"https://github.com/LiveContainer/LiveContainer/releases/download/1.0/apps_ss_lc.json"];
+        }
     });
     return sourceURL;
 }
