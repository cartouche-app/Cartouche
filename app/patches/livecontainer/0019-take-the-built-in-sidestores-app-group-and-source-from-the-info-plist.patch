 LiveContainer/LCSharedUtils.m               | 41 +++++++++++++++++++--
 LiveContainerSwiftUI/Utilities/Shared.swift |  2 +-
 LiveContainerSwiftUI/Views/LCTabView.swift  |  4 ++
 SideStoreSupport/SideStoreHooks.m           | 17 ++++++++-
 5 files changed, 60 insertions(+), 6 deletions(-)

diff --git a/LiveContainer/LCSharedUtils.h b/LiveContainer/LCSharedUtils.h
index 8d4d6e2..6181cf0 100644
--- a/LiveContainer/LCSharedUtils.h
+++ b/LiveContainer/LCSharedUtils.h
@@ -5,6 +5,8 @@
 + (NSDictionary *)cartoucheSigningMaterial;
 + (void)setCartoucheSigningCandidate:(NSDictionary *)material;
 + (NSString*) teamIdentifier;
++ (NSDictionary *)cartoucheAppInfo;
++ (NSString *)builtInSideStoreAppGroup;
 + (BOOL)isBuiltInSideStoreAppGroup:(NSString *)group;
 + (NSString *)appGroupID;
 + (NSURL*) appGroupPath;
diff --git a/LiveContainer/LCSharedUtils.m b/LiveContainer/LCSharedUtils.m
index 9b3ed27..56f9d18 100644
--- a/LiveContainer/LCSharedUtils.m
+++ b/LiveContainer/LCSharedUtils.m
@@ -102,11 +102,46 @@ static NSDictionary *cartoucheCachedSigningMaterial;
     return ans;
 }
 
+// Cartouche's own Info.plist, read the same way in the app and in its
+// extensions, such as LiveProcess, where the built-in SideStore renews and
+// updates the app: an extension's is the app's, two folders up.
++ (NSDictionary *)cartoucheAppInfo {
+    static NSDictionary *info = nil;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        NSBundle *host = lcMainBundle ?: NSBundle.mainBundle;
+        NSURL *app = host.bundleURL;
+        if ([app.pathExtension isEqualToString:@"appex"]) {
+            app = app.URLByDeletingLastPathComponent.URLByDeletingLastPathComponent;
+        }
+        info = [NSDictionary dictionaryWithContentsOfURL:[app URLByAppendingPathComponent:@"Info.plist"]]
+            ?: host.infoDictionary ?: @{};
+    });
+    return info;
+}
+
+// The built-in SideStore's app group, without the team identifier signing
+// appends: LiveContainer+SideStore's, or the one of Cartouche's IPA for the
+// player's own SideStore, which its Info.plist names (CartoucheAppGroup,
+// app/scripts/sidestore_ipa.py). That group begins with the other, so that
+// every test of the group by its beginning still finds the built-in
+// SideStore's, and it never is the group the player's SideStore keeps its
+// own apps in.
++ (NSString *)builtInSideStoreAppGroup {
+    NSString *base = @"group.com.SideStore.SideStore";
+    NSString *own = [self cartoucheAppInfo][@"CartoucheAppGroup"];
+    if ([own isKindOfClass:NSString.class] && [own hasPrefix:[base stringByAppendingString:@"."]]) {
+        return own;
+    }
+    return base;
+}
+
 // The built-in SideStore's app group, alone or with the team identifier that
 // signing appends. Any other group belongs to another app, such as a
-// LiveContainer+SideStore on the same iPhone, and is never used.
+// LiveContainer+SideStore or the player's own SideStore on the same iPhone,
+// and is never used.
 + (BOOL)isBuiltInSideStoreAppGroup:(NSString *)group {
-    NSString *base = @"group.com.SideStore.SideStore";
+    NSString *base = [self builtInSideStoreAppGroup];
     return [group isEqualToString:base] || [group hasPrefix:[base stringByAppendingString:@"."]];
 }
 
@@ -121,7 +156,7 @@ static NSDictionary *cartoucheCachedSigningMaterial;
             return;
         }
         NSArray* possibleAppGroups = @[
-            [@"group.com.SideStore.SideStore." stringByAppendingString:[self teamIdentifier]]
+            [[[self builtInSideStoreAppGroup] stringByAppendingString:@"."] stringByAppendingString:[self teamIdentifier]]
         ];
         
         // we prefer app groups with "Apps" in it, which indicate this app group is actually used by the store.
