@@ -232,6 +245,64 @@ enum CartoucheAnisette
         return SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
     }
 
+    // MARK: - Apple's answer to a new machine
+
+    /// Apple's own answer to the provisioning of a new machine, which goes
+    /// from this iPhone straight to Apple's servers (AnisetteKit's
+    /// AnisetteClient, at gsa.apple.com), whichever server signs it: an HTTP
+    /// error from one of its steps, or an answer of Apple's that could not
+    /// be read.
+    struct ProvisioningAnswer: Equatable
+    {
+        /// The case of AnisetteKit's error: "httpError" or "invalidResponse".
+        var kind: String
+        /// Apple's HTTP status, for an HTTP error.
+        var status: Int?
+        /// The step that answered: "lookup", "start" (Apple's SPIM) or
+        /// "finish" (its PTM and TK).
+        var step: String
+    }
+
+    /// The words AnisetteKit's AnisetteClient names each step of the
+    /// provisioning by, in its HTTP errors ("Apple PTM/TK endpoint returned
+    /// HTTP 401") and its answers it could not read ("Failed to parse ptm/tk
+    /// from Apple response"), whatever their case, with the names Cartouche's
+    /// measurements send of them.
+    static let provisioningSteps: [(words: String, step: String)] = [
+        ("lookup", "lookup"),
+        ("spim", "start"),
+        ("ptm/tk", "finish"),
+    ]
+
+    /// Apple's answer to a new machine, when ERROR is one: AnisetteKit's HTTP
+    /// error or answer it could not read, whose words name one of the steps
+    /// above. AnisetteKit gives the same answer it could not read for the
+    /// server's headers ("Missing X-Apple-I-MD or X-Apple-I-MD-M from
+    /// response"), which names none: the next server may answer. Its words
+    /// never leave, only the names above and the status.
+    static func provisioningAnswer(of error: Error) -> ProvisioningAnswer?
+    {
+        let kind: String
+        let status: Int?
+        let words: String
+        switch error as? AnisetteKit.AnisetteError
+        {
+        case .httpError(let statusCode, let message)?:
+            kind = "httpError"
+            status = (100...599).contains(statusCode) ? statusCode : nil
+            words = message
+        case .invalidResponse(let reason)?:
+            kind = "invalidResponse"
+            status = nil
+            words = reason
+        default:
+            return nil
+        }
+        let lowered = words.lowercased()
+        guard let step = self.provisioningSteps.first(where: { lowered.contains($0.words) })?.step else { return nil }
+        return ProvisioningAnswer(kind: kind, status: status, step: step)
+    }
+
