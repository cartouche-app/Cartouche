 //  serial, a path or an address: only the names below, chosen here, those
 //  of SideStore's error cases and operations, and numbers. Cartouche checks
@@ -213,6 +221,13 @@ final class CartoucheOutcome: @unchecked Sendable
                     outcome["retryAfter"] = retryAfter
                 }
             }
+            // Apple's answer to a new machine, and the step of its
+            // provisioning that gave it (CartoucheAnisette).
+            if let answer = CartoucheAnisette.provisioningAnswer(of: error)
+            {
+                outcome["service"] = "provisioning"
+                outcome["reason"] = answer.step
+            }
             if let (code, host) = Self.network(of: error)
             {
                 outcome["network"] = code
@@ -513,6 +528,12 @@ final class CartoucheOutcome: @unchecked Sendable
         case is DecodingError: family = "decoding"
         case is CancellationError: return ("cancelled", "cancelled")
         default:
+            // Apple's answer to a new machine (CartoucheAnisette), which
+            // AnisetteKit gives.
+            if let answer = CartoucheAnisette.provisioningAnswer(of: error)
+            {
+                return ("provisioning", answer.kind)
+            }
             let nsError = error as NSError
             switch nsError.domain
             {
@@ -593,7 +614,8 @@ final class CartoucheOutcome: @unchecked Sendable
             guard let range = reason.range(of: "HTTP [1-5][0-9][0-9]", options: .regularExpression) else { return nil }
             return Int(reason[range].dropFirst(5))
         default:
-            return nil
+            // Apple's, to a new machine.
+            return CartoucheAnisette.provisioningAnswer(of: error)?.status
         }
     }
 
