+    // MARK: - This iPhone's port, looked for again
+
+    private static var portLookup: CartouchePortLookup.Found?
+
+    /// Notes what looking for this iPhone's RemotePairing port again found
+    /// (withRemotePairingRetry): the last lookup of the action counts.
+    static func lookedForPort(_ found: CartouchePortLookup.Found)
+    {
+        self.trailLock.lock()
+        defer { self.trailLock.unlock() }
+        self.portLookup = found
+    }
+
+    private static func takePortLookup() -> CartouchePortLookup.Found?
+    {
+        self.trailLock.lock()
+        defer { self.trailLock.unlock() }
+        return self.portLookup
+    }
+
     // MARK: - Outcome
 
     let action: Action
@@ -143,6 +168,7 @@ final class CartoucheOutcome: @unchecked Sendable
         Self.trailLock.lock()
         Self.trail = []
         Self.resends = 0
+        Self.portLookup = nil
         Self.trailLock.unlock()
         Self.delete()
     }
@@ -182,6 +208,10 @@ final class CartoucheOutcome: @unchecked Sendable
         {
             outcome["resent"] = resends
         }
+        if let found = Self.takePortLookup()
+        {
+            outcome["portLookup"] = found.rawValue
+        }
         if let progress, progress.totalUnitCount > 0
         {
             let fraction = min(max(progress.fractionCompleted, 0), 1)
