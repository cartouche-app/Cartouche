    "signIn.cannotComplete" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat diese Anmeldung ohne Angabe von Gründen abgelehnt (-22405). Es gibt nichts zurückzusetzen oder neu zu installieren. Warte ein paar Stunden und melde dich dann einmal erneut an. Lehnt Apple am nächsten Tag immer noch ab, melde dich in Safari bei account.apple.com an: Apple sagt dort, ob deine Apple-ID etwas von dir braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple refused this sign-in without saying why (-22405). There is nothing to reset or reinstall. Wait a few hours, then sign in again, once. If Apple still refuses the next day, sign in at account.apple.com in Safari: Apple says there whether your Apple ID needs anything from you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple rechazó este inicio de sesión sin decir por qué (-22405). No hay nada que restablecer ni reinstalar. Espera unas horas y vuelve a iniciar sesión, una vez. Si Apple sigue rechazándolo al día siguiente, inicia sesión en account.apple.com en Safari: Apple dice allí si tu ID de Apple necesita algo de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a refusé cette connexion sans en donner la raison (-22405). Il n’y a rien à réinitialiser ni à réinstaller. Attendez quelques heures, puis reconnectez-vous, une seule fois. Si Apple refuse encore le lendemain, connectez-vous sur account.apple.com dans Safari : Apple y dit si votre identifiant Apple attend quelque chose de vous."
          }
        }
      }
    },
    "signIn.certificateUnopened" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der integrierte SideStore hat sich angemeldet, aber Cartouche konnte das erhaltene Zertifikat nicht öffnen. Kopiere den Bericht für die Person, die dir hilft."
