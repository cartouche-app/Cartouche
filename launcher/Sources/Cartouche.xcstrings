    "setting.note.dynamicResolution" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt die Auflösung unter Last zwischen %1$@ und %2$@ an. Schalte es aus, um die volle Auflösung des gewählten Konsolenmodus zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjusts resolution between %1$@ and %2$@ under load. Turn off to keep full resolution for the selected console mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la resolución entre %1$@ y %2$@ cuando hay carga. Desactívalo para mantener la resolución completa del modo de consola elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapte la résolution entre %1$@ et %2$@ selon la charge. Désactivez-la pour garder la pleine résolution du mode de console choisi."
          }
        }
      }
    },
    "setting.note.dynamicResolutionLoad" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt das Spiel unter Last seine Auflösung senken. Schalte es aus, um die volle Auflösung des gewählten Konsolenmodus zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the game lower its resolution under load. Turn off to keep full resolution for the selected console mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el juego baje su resolución cuando hay carga. Desactívalo para mantener la resolución completa del modo de consola elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse le jeu baisser sa résolution selon la charge. Désactivez-la pour garder la pleine résolution du mode de console choisi."
          }
        }
      }
    },
    "setting.note.frameBuffering" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu einem Bild mehr Anzeigeverzögerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to one frame more display latency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta un fotograma más de latencia en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à une image de latence d’affichage en plus."
          }
        }
      }
    },
    "setting.note.languages" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien dieses Spiels nennen seine Sprachen nicht, daher sind einige davon vielleicht nicht im Spiel. Es zeigt dann womöglich eine andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This game’s files do not list its languages, so some of these may not be in the game. It may then show another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de este juego no indican sus idiomas, así que puede que algunos de estos no estén en el juego. Puede mostrar entonces otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de ce jeu ne listent pas ses langues : certaines peuvent lui manquer, et il en affiche alors une autre."
          }
        }
      }
    },
    "setting.note.metal4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält ein Pipeline-Archiv; braucht mehr Arbeitsspeicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps a pipeline archive; uses more memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un archivo de pipelines; usa más memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde une archive des pipelines ; utilise plus de mémoire."
          }
        }
      }
    },
    "setting.note.microphone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt das Spiel dein Mikrofon hören. macOS fragt nach dem Zugriff, wenn du das Spiel damit startest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the game hear your microphone. macOS asks for access when you launch with this enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que el juego oiga tu micrófono. macOS pide acceso cuando inicias el juego con esto activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse le jeu entendre votre micro. macOS en demande l’accès quand vous lancez le jeu avec ce réglage activé."
          }
        }
      }
    },
    "setting.note.picture" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Füllen“ beschneidet das 16:9-Bild des Spiels, um den Bildschirm zu füllen. Lebensbalken, Untertitel oder Karten nahe den Rändern können abgeschnitten werden. Ein Vollbild ohne Beschnitt braucht für jedes Spiel einen Patch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill crops the game’s 16:9 picture to cover the screen. Health bars, subtitles or maps near the edges can be cut off. A full-screen picture without cropping needs a patch for each game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellenar recorta la imagen 16:9 del juego para cubrir la pantalla. Las barras de salud, los subtítulos o los mapas cerca de los bordes pueden quedar cortados. Una imagen a pantalla completa sin recorte necesita un parche para cada juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplir recadre l’image 16:9 du jeu pour couvrir l’écran. Les jauges, sous-titres ou cartes près des bords peuvent être coupés. Une image plein écran sans recadrage demande un correctif pour chaque jeu."
          }
        }
      }
    },
    "setting.note.pictureShape" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechnet etwa ein Viertel mehr Pixel: etwas langsamer und wärmer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renders about a quarter more pixels: a little slower and warmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja aproximadamente una cuarta parte más de píxeles: algo más lento y caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcule environ un quart de pixels en plus : un peu plus lent, et un peu plus chaud."
          }
        }
      }
    },
    "setting.note.pictureShapeTaller" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Formen berechnen mehr Pixel und können GPU-Zeit und Wärme erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taller shapes render more pixels and can increase GPU time and heat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las formas más altas dibujan más píxeles y pueden aumentar el tiempo de GPU y el calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un format plus haut calcule plus de pixels : il demande plus de temps au GPU et peut faire chauffer l’appareil."
          }
        }
      }
    },
    "setting.note.prebuild" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Start wartet einmalig ein paar Minuten darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first start waits a few minutes for it, once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer inicio espera unos minutos por ello, una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier lancement l’attend quelques minutes, une seule fois."
          }
        }
      }
    },
    "setting.note.switch2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt mit Joy-Con 2 und Pro Controller 2 über Bluetooth: Halte während des Spiels die Sync-Taste eines Controllers gedrückt, um ihn zu koppeln. macOS fragt einmal nach Bluetooth-Zugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juega con los Joy-Con 2 y el Pro Controller 2 por Bluetooth: mantén pulsado el botón de sincronización de uno de ellos durante la partida para emparejarlo. macOS pide una vez acceso al Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue avec les Joy-Con 2 et la manette Pro 2 en Bluetooth : maintenez le bouton de synchronisation de l’une d’elles pendant la partie pour l’associer. macOS demande une fois l’accès au Bluetooth."
          }
        }
      }
    },
    "setting.note.textureFiltering" : {
