    "mac.builds.link.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende die App auf deinem Mac, öffne dann dieses Image und zieh die App in „Programme“, anstelle der alten. Danach aktualisiert sie sich selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit the app on your Mac, then open this disk image and drag the app onto Applications, in place of the old one. It updates itself after that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la app en tu Mac, abre esta imagen de disco y arrastra la app a Aplicaciones, en lugar de la antigua. Después se actualiza sola."
          }
