    "saves.fetched.kept" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuesten Spielstände, vom %1$@, kamen aus deinem Spielstandordner. Die dieses iPhone werden dort als Kopie vom %2$@ aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The newest saves, of %1$@, came from your saves folder. This iPhone’s are kept there as the copy of %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partidas guardadas más recientes, del %1$@, vinieron de tu carpeta de partidas guardadas. Las de este iPhone se conservan allí como la copia del %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes les plus récentes, du %1$@, sont arrivées de votre dossier des sauvegardes. Celles de cet iPhone y sont gardées : copie du %2$@."
          }
        }
      }
    },
    "saves.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche hält diese Spielstände mit deinem Spielstandordner synchron: Die neuesten kommen, wenn das Spiel installiert wird und bevor es startet, und gehen ein paar Sekunden nach jedem Speichern des Spiels dorthin, spätestens nach dem Spiel. Haben sich beide geändert, gewinnen die neuesten, und die anderen bleiben als Kopie. Die %lld neuesten Kopien werden behalten, eine für jede gespielte Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche keeps these saves in step with your saves folder: the newest come when the game is installed and before it starts, and go there a few seconds after each save of the game, after the game at the latest. When both changed, the newest win and the others stay as a copy. The %lld newest copies are kept, one for each game played."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche mantiene estas partidas guardadas al compás de tu carpeta de partidas guardadas: las más recientes llegan cuando se instala el juego y antes de que arranque, y van allí unos segundos después de cada guardado del juego, como muy tarde tras la partida. Cuando cambiaron ambas, ganan las más recientes y las otras se quedan como copia. Se conservan las %lld copias más recientes, una por cada partida jugada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche synchronise ces sauvegardes avec votre dossier des sauvegardes : les plus récentes arrivent à l’installation du jeu et avant chaque lancement, et y repartent quelques secondes après chaque sauvegarde du jeu, au plus tard après la partie. Si les deux ont changé, les plus récentes l’emportent et les autres restent en copie. Les %lld copies les plus récentes sont gardées, une par partie."
          }
        }
      }
    },
    "saves.kept" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuere Spielstände sind in deinem Spielstandordner: Sie kommen beim nächsten Start des Spiels. Die dieses iPhone werden dort als Kopie vom %@ aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Newer saves are in your saves folder: they come when the game next starts. This iPhone’s are kept there as the copy of %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay partidas guardadas más recientes en tu carpeta de partidas guardadas: llegan la próxima vez que se inicie el juego. Las de este iPhone se conservan allí como la copia del %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des sauvegardes plus récentes sont dans votre dossier des sauvegardes : elles arrivent au prochain lancement du jeu. Celles de cet iPhone y sont gardées : copie du %@."
          }
        }
      }
    },
