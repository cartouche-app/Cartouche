    "work.start.certificateRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS akzeptiert das Zertifikat nicht mehr, mit dem das Spiel signiert wurde. Cartouche meldet sich erneut mit deiner Apple-ID an, um das neue zu holen: Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no longer accepts the certificate the game was signed with. Cartouche signs in again with your Apple ID to take the new one: try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ya no acepta el certificado con el que se firmó el juego. Cartouche vuelve a iniciar sesión con tu ID de Apple para obtener el nuevo: vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n’accepte plus le certificat qui a signé le jeu. Cartouche se reconnecte avec votre identifiant Apple pour prendre le nouveau : réessayez dans un instant."
          }
        }
      }
    },
