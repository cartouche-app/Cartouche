          }
        }
      }
    },
    "running.stopped.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat das Spiel nahe seinem Limit von %@ hinter Cartouche geschlossen. Ab jetzt startet es anstelle von Cartouche, mit dem ganzen Arbeitsspeicher von Cartouche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS closed the game near its limit of %@ behind Cartouche. From now on, it starts in Cartouche’s place, with all of Cartouche’s memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS cerró el juego cerca de su límite de %@ detrás de Cartouche. A partir de ahora, se inicia en lugar de Cartouche, con toda la memoria de Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a fermé le jeu près de sa limite de %@ derrière Cartouche. Désormais, il démarre à la place de Cartouche, avec toute la mémoire de Cartouche."
          }
        }
      }
    },
    "running.stopped.memory.behind" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat das Spiel nahe seinem Limit von %@ hinter Cartouche geschlossen: Anstelle von Cartouche hätte es nicht mehr Arbeitsspeicher. Dein Fortschritt bleibt bis zum letzten Speichern erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS closed the game near its limit of %@ behind Cartouche: in Cartouche’s place, it would have no more memory. Your progress is kept up to its last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS cerró el juego cerca de su límite de %@ detrás de Cartouche: en lugar de Cartouche, no tendría más memoria. Tu progreso se conserva hasta su última partida guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a fermé le jeu près de sa limite de %@ derrière Cartouche : à la place de Cartouche, il n’aurait pas plus de mémoire. Votre progression est gardée jusqu’à sa dernière sauvegarde."
          }
        }
      }
    },
    "running.stopped.paused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat das Spiel geschlossen, während es pausiert war. Dein Fortschritt bleibt bis zum letzten Speichern erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS closed the game while it was paused. Your progress is kept up to its last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS cerró el juego mientras estaba en pausa. Tu progreso se conserva hasta su última partida guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a fermé le jeu pendant sa pause. Votre progression est gardée jusqu’à sa dernière sauvegarde."
          }
        }
      }
    },
    "running.stopped.signature" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat beim Start die Signatur des Spiels abgelehnt. Signiere es erneut; schlägt es weiter fehl, installiere es erneut aus seiner IPA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS refused the game’s signature as it started. Sign it again; if it still fails, install it again from its IPA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS rechazó la firma del juego al iniciarse. Vuelve a firmarlo; si sigue fallando, vuelve a instalarlo desde su IPA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a refusé la signature du jeu à son démarrage. Signez-le de nouveau ; si cela échoue encore, installez-le de nouveau depuis son IPA."
          }
        }
      }
    },
    "running.stopped.space" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Spiel fehlte auf diesem iPhone der Platz für seinen Speicher, den es während des Spielens in Dateien hält: %@ waren frei. Schaffe Platz und spiele dann erneut. Dein Fortschritt bleibt bis zum letzten Speichern erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ran out of room on this iPhone for its memory, which it keeps in files while it plays: %@ was free. Free up some space, then play again. Your progress is kept up to its last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se quedó sin espacio en este iPhone para su memoria, que guarda en archivos mientras se juega: quedaban %@ libres. Libera espacio y vuelve a jugar. Tu progreso se conserva hasta su última partida guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu n’avait plus de place sur cet iPhone pour sa mémoire, qu’il garde dans des fichiers pendant la partie : il restait %@ de libre. Libérez de la place, puis rejouez. Votre progression est gardée jusqu’à sa dernière sauvegarde."
          }
        }
      }
    },
    "running.stopped.space.purgeable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Spiel fehlte auf diesem iPhone der Platz für seinen Speicher, den es während des Spielens in Dateien hält: %1$@ waren frei. iOS zählt %2$@ als verfügbar, gibt den Rest aber erst frei, wenn ihm selbst der Platz ausgeht, zu spät für das Spiel. Schaffe Platz, etwa die IPAs bereits installierter Spiele, und spiele dann erneut. Dein Fortschritt bleibt bis zum letzten Speichern erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ran out of room on this iPhone for its memory, which it keeps in files while it plays: %1$@ was free. iOS counts %2$@ as available, but frees the rest only once it runs short itself, too late for the game. Free up some space, such as the IPAs of games already installed, then play again. Your progress is kept up to its last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se quedó sin espacio en este iPhone para su memoria, que guarda en archivos mientras se juega: quedaban %1$@ libres. iOS cuenta %2$@ como disponibles, pero solo libera el resto cuando a él mismo le falta, demasiado tarde para el juego. Libera espacio, por ejemplo los IPA de los juegos ya instalados, y vuelve a jugar. Tu progreso se conserva hasta su última partida guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu n’avait plus de place sur cet iPhone pour sa mémoire, qu’il garde dans des fichiers pendant la partie : il restait %1$@ de libre. iOS compte %2$@ de disponible, mais ne libère le reste que quand il en manque lui-même, trop tard pour le jeu. Libérez de la place, par exemple les IPA des jeux déjà installés, puis rejouez. Votre progression est gardée jusqu’à sa dernière sauvegarde."
          }
        }
      }
    },
    "running.stopped.title" : {
      "extractionState" : "manual",
      "localizations" : {
