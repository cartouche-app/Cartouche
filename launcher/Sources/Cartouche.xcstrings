    "signing.refused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat dieses Zertifikat abgelehnt. Importiere ein anderes, oder installiere Cartouche erneut mit einem neuen Zertifikat und seinem Profil, über den Cartouche-Installer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS refused this certificate. Import another one, or install Cartouche again with a new certificate and its profile, from the Cartouche Installer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS rechazó este certificado. Importa otro, o vuelve a instalar Cartouche con un certificado nuevo y su perfil, desde el Instalador de Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a refusé ce certificat. Importez-en un autre, ou réinstallez Cartouche avec un nouveau certificat et son profil, depuis l’Installeur Cartouche."
          }
        }
      }
    },
    "signing.refusedOnIPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat dieses Zertifikat abgelehnt, das vielleicht widerrufen wurde. Signiere Cartouche in deiner Signier-App erneut mit einem gültigen Zertifikat und wähle dann hier dieses Zertifikat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS refused this certificate, which may have been revoked. Sign Cartouche again with a valid certificate in your signing app, then choose that certificate here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS rechazó este certificado, que puede haber sido revocado. Vuelve a firmar Cartouche con un certificado válido en tu app de firma y luego elige ese certificado aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a refusé ce certificat, qui a peut-être été révoqué. Signez Cartouche à nouveau avec un certificat valide dans votre app de signature, puis choisissez ce certificat ici."
          }
        }
      }
    },
    "signing.reinstall" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt das Profil, mit dem Cartouche installiert wurde, dieses Zertifikat nicht, installiere Cartouche erneut damit und mit seinem Profil, über den Cartouche-Installer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the profile Cartouche was installed with does not allow this certificate, install Cartouche again with it and its profile, from the Cartouche Installer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el perfil con el que se instaló Cartouche no permite este certificado, vuelve a instalar Cartouche con él y su perfil, desde el Instalador de Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le profil avec lequel Cartouche a été installé n’autorise pas ce certificat, réinstallez Cartouche avec lui et son profil, depuis l’Installeur Cartouche."
          }
        }
      }
    },
    "signing.signerRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Passwort stimmt, aber Cartouche kann mit diesem Zertifikat nicht signieren. Exportiere die .p12 erneut mit ihrem privaten Schlüssel, oder verwende ein anderes Zertifikat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its password is right, but Cartouche cannot sign with this certificate. Export the .p12 again with its private key, or use another certificate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su contraseña es correcta, pero Cartouche no puede firmar con este certificado. Vuelve a exportar el .p12 con su clave privada, o usa otro certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son mot de passe est le bon, mais Cartouche ne peut pas signer avec ce certificat. Exportez à nouveau le .p12 avec sa clé privée, ou utilisez un autre certificat."
          }
        }
      }
    },
