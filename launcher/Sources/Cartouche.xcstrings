    "storage.mac.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf deinem Mac Cartouche und schalte „Mit Cartouche auf dem iPhone teilen“ auf der iPhone-Seite des Builder ein. Schließe dann dieses iPhone per Kabel an den Mac an, oder bring beide ins selbe WLAN. Unterwegs, mit Tailscale auf beiden, kopple über seine Adresse, unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Mac, open Cartouche and turn on Share with Cartouche on the iPhone, on the Builder’s iPhone page. Then plug this iPhone into the Mac with a cable, or put both on the same Wi-Fi. Away from home, with Tailscale on both, pair it by its address, below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu Mac, abre Cartouche y activa Compartir con Cartouche en el iPhone, en la página iPhone del Builder. Luego conecta este iPhone al Mac con un cable, o pon ambos en la misma red Wi-Fi. Fuera de casa, con Tailscale en ambos, empareja por su dirección, abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre Mac, ouvrez Cartouche et activez Partager avec Cartouche sur l’iPhone, dans la page iPhone du Builder. Branchez ensuite cet iPhone au Mac avec un câble, ou mettez-les sur le même Wi-Fi. Hors de chez vous, avec Tailscale sur les deux, associez-le par son adresse, plus bas."
          }
        }
      }
    },
