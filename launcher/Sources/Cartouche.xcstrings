    },
    "running.stopped.error" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel wurde durch einen Fehler beendet, den der Bericht angibt. Passiert es wieder, installiere das Spiel erneut aus seiner IPA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game stopped on an error, which the report gives. If it happens again, install the game again from its IPA."
          }
