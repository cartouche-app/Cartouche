            "value" : "Das Spiel hat sich von selbst geschlossen. Dein Fortschritt bleibt bis zum letzten Speichern erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game closed on its own. Your progress is kept up to its last save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se cerró solo. Tu progreso se conserva hasta su última partida guardada."
