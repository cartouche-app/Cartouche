        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren, wenn der Controller getrennt wird"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause when the controller disconnects"
          }
        },
