    "storage.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Spiele und Spielstände auf deinem eigenen Speicher: dein Mac mit Cartouche, ein freigegebener Ordner deines Mac, PC oder NAS, ein S3-Bucket, ein FTP- oder SFTP-Server, dein Google Drive oder ein Ordner in „Dateien“. Seine Spiele erscheinen in deiner Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your games and saves on your own storage: your Mac with Cartouche, a shared folder of your Mac, PC or NAS, an S3 bucket, an FTP or SFTP server, your Google Drive, or a folder in Files. Its games show in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus juegos y partidas guardadas en tu propio almacenamiento: tu Mac con Cartouche, una carpeta compartida de tu Mac, PC o NAS, un bucket S3, un servidor FTP o SFTP, tu Google Drive o una carpeta en Archivos. Sus juegos aparecen en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jeux et sauvegardes sur votre propre stockage : votre Mac avec Cartouche, dossier partagé de votre Mac, PC ou NAS, bucket S3, serveur FTP ou SFTP, votre Google Drive, ou dossier de Fichiers. Ses jeux apparaissent dans votre bibliothèque."
          }
        }
      }
    },
