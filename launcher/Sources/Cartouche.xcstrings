        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se detuvo por un error, que indica el informe. Si vuelve a pasar, vuelve a instalar el juego desde su IPA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
