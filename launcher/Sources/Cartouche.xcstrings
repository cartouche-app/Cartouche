    "signing.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle dein Zertifikat (.p12), sein Passwort und sein Profil (.mobileprovision). Weder eine Apple-ID noch LocalDevVPN wird benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your certificate (.p12), its password and its profile (.mobileprovision). Neither an Apple ID nor LocalDevVPN is needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu certificado (.p12), su contraseña y su perfil (.mobileprovision). No hace falta ni ID de Apple ni LocalDevVPN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez votre certificat (.p12), son mot de passe et son profil (.mobileprovision). Ni compte Apple ni LocalDevVPN ne sont nécessaires."
          }
        }
      }
    },
    "signing.howOnIPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Zertifikat (.p12), mit dem deine Signier-App Cartouche signiert hat, und gib sein Passwort ein. Cartouche liest sein Profil selbst. Weder eine Apple-ID noch LocalDevVPN wird benötigt."
          }
        },
