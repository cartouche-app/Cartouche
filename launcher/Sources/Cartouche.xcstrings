    "storage.tailscale.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Tailscale, separat auf diesem iPhone und auf deinem Mac oder NAS installiert, erreicht Cartouche sie, wo immer du bist: deinen Mac von selbst, ein NAS über seinen Namen oder seine Adresse in Tailscale. iOS hält immer nur ein VPN: LocalDevVPN, das Cartouche zum Erneuern und Aktualisieren verbindet, schaltet Tailscale aus, bis du es wieder einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Tailscale, installed apart on this iPhone and on your Mac or NAS, Cartouche reaches them wherever you are: your Mac by itself, a NAS by its name or its address in Tailscale. iOS keeps one VPN at a time: LocalDevVPN, which Cartouche connects to renew and update itself, turns Tailscale off until you turn it on again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Tailscale, instalado aparte en este iPhone y en tu Mac o NAS, Cartouche llega a ellos estés donde estés: tu Mac solo, un NAS por su nombre o su dirección en Tailscale. iOS mantiene una sola VPN a la vez: LocalDevVPN, que Cartouche conecta para renovarse y actualizarse, apaga Tailscale hasta que lo vuelvas a encender."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Tailscale, installé à part sur cet iPhone et sur votre Mac ou votre NAS, Cartouche les rejoint où que vous soyez : votre Mac de lui-même, un NAS par son nom ou son adresse dans Tailscale. iOS ne garde qu’un VPN à la fois : LocalDevVPN, que Cartouche connecte pour se renouveler et se mettre à jour, éteint Tailscale jusqu’à ce que vous le rallumiez."
          }
        }
      }
    },
