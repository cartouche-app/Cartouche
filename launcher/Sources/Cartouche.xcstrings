        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac erstellt ein Spiel, dem er folgt, erneut, wenn nxnative es verbessert, und ein Spiel, dem er nicht folgt, nur auf deinen Wunsch."
          }
        },
        "en" : {
          "stringUnit" : {
