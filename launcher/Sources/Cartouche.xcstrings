    "storage.drive.client.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche hat keinen eigenen Google-Schlüssel: Es erreicht dein Drive über einen OAuth-Client von dir, einmal kostenlos in Google Cloud erstellt. Füge seine ID ein, oder den ganzen Text, den Google Cloud dazu gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche has no Google key of its own: it reaches your Drive through an OAuth client of yours, made once, for free, in Google Cloud. Paste its ID, or all the text Google Cloud gives with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche no tiene clave de Google propia: llega a tu Drive a través de un cliente OAuth tuyo, creado una vez, gratis, en Google Cloud. Pega su ID, o todo el texto que da Google Cloud con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche n’a pas de clé Google à lui : il accède à votre Drive par un client OAuth à vous, créé une fois, gratuitement, dans Google Cloud. Collez son ID, ou tout le texte que Google Cloud donne avec."
          }
        }
      }
    },
