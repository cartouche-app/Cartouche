        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your library shows the IPAs of these folders, ready to install: a game in more than one shows once, and installs from a folder that answers. Copy a game to the first one before you uninstall it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu biblioteca muestra las IPA de estas carpetas, listas para instalar: un juego en varias aparece una vez y se instala desde una carpeta que responda. Copia un juego en la primera antes de desinstalarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
