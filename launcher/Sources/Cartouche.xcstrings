    "cloud.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud nimmt ein Spiel, das du besitzt, erstellt es auf einem Mac in der Cloud und gibt dir die App zurück, die Cartouche auf deinem iPhone installiert. Es stellt kein Spiel bereit: Du sendest deine eigene Kopie von einem Computer aus über seine Website, und sie wird nur für dich erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud takes a game you own, builds it on a Mac in the cloud, and gives you back the app Cartouche installs on your iPhone. It provides no game: you send your own copy from a computer, on its site, and it is built for you alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud toma un juego que tienes, lo compila en un Mac en la nube y te devuelve la app que Cartouche instala en tu iPhone. No proporciona ningún juego: envías tu propia copia desde un ordenador, en su sitio, y se compila solo para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud prend un jeu que vous possédez, le construit sur un Mac dans le cloud, et vous rend l’app que Cartouche installe sur votre iPhone. Il ne fournit aucun jeu : vous envoyez votre propre copie depuis un ordinateur, sur son site, et elle est construite pour vous seul."
          }
        }
      }
    },
    "cloud.invitation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud befindet sich in einem geschlossenen Test: Vorerst können es nur eingeladene Spieler nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche Cloud is in a closed trial: for now, only invited players can use it."
