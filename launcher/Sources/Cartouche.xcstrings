        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Apple-ID, die du dem Cartouche-Installer gegeben hast; eine kostenlose reicht. Cartouche signiert deine Spiele damit und erneuert sich jede Woche."
          }
        },
        "en" : {
          "stringUnit" : {
