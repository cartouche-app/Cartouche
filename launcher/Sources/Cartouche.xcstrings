    "sideStore.appleID.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich einmal an, mit der Apple-ID, die dein SideStore verwendet: Cartouche holt das Zertifikat, mit dem SideStore es signiert hat, und erneuert sich dann jede Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in once, with the Apple ID your SideStore uses: Cartouche takes the certificate SideStore signed it with, then renews itself every week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión una vez, con el ID de Apple que usa tu SideStore: Cartouche obtiene el certificado con el que lo firmó SideStore y luego se renueva cada semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois, avec l’identifiant Apple de votre SideStore : Cartouche reprend le certificat avec lequel SideStore l’a signé, puis se renouvelle chaque semaine."
          }
        }
      }
    },
    "sideStore.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier Schritte, einmal auf diesem iPhone, dann eine Automation, die Cartouche jede Nacht erneuert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four steps, once on this iPhone, then an automation that renews Cartouche every night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro pasos, una vez en este iPhone, y luego una automatización que renueva Cartouche cada noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatre étapes, une seule fois sur cet iPhone, puis une automatisation qui renouvelle Cartouche chaque nuit."
          }
        }
      }
    },
    "sideStore.memory.afterSetup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein SideStore lässt es mit einer kostenlosen Apple-ID weg: Ohne es gibt iOS Cartouche und seinen Spielen etwa 3 GB. Sobald die Schritte oben erledigt sind, installiert sich Cartouche einmal neu, um es zu bekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your SideStore leaves it out with a free Apple ID: without it, iOS gives Cartouche and its games about 3 GB. Once the steps above are done, Cartouche installs itself again, once, to get it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu SideStore la deja fuera con un ID de Apple gratuito: sin ella, iOS da unos 3 GB a Cartouche y a sus juegos. Cuando estén hechos los pasos de arriba, Cartouche se vuelve a instalar, una vez, para obtenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre SideStore la laisse de côté avec un identifiant Apple gratuit : sans elle, iOS donne environ 3 Go à Cartouche et à ses jeux. Une fois les étapes ci-dessus faites, Cartouche s’installe à nouveau, une fois, pour l’obtenir."
          }
        }
      }
    },
