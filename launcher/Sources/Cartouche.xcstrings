          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el ID de Apple que diste al Instalador de Cartouche; sirve uno gratuito. Cartouche firma tus juegos con él y se renueva cada semana."
          }
