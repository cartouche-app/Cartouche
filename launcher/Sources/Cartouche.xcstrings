          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez en este iPhone: Cartouche lo registra en tu cuenta, obtiene su certificado y se renueva cada semana, sin volver a preguntarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois sur cet iPhone : Cartouche l’inscrit sur votre compte, prend son certificat et se renouvelle chaque semaine, sans vous le redemander."
          }
        }
      }
    },
