    "sheet.inPlace" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter Cartouche hätte dieses Spiel zu wenig Arbeitsspeicher: Es startet anstelle von Cartouche, und die Konsole schließt sich, während es läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behind Cartouche, this game would run short of memory: it starts in Cartouche’s place, and the console closes while it runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detrás de Cartouche, a este juego le faltaría memoria: se inicia en lugar de Cartouche, y la consola se cierra mientras funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrière Cartouche, ce jeu manquerait de mémoire : il démarre à la place de Cartouche, et la console se ferme pendant qu’il tourne."
          }
        }
      }
    },
    "sheet.inPlace.iml" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter Cartouche haben Spiele hier nur %@, ohne das erhöhte Speicherlimit: Dieses Spiel startet anstelle von Cartouche, und die Konsole schließt sich, während es läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behind Cartouche, games have only %@ here, without Increased Memory Limit: this game starts in Cartouche’s place, and the console closes while it runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detrás de Cartouche, los juegos solo tienen %@ aquí, sin la memoria ampliada: este juego se inicia en lugar de Cartouche, y la consola se cierra mientras funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrière Cartouche, les jeux n’ont ici que %@, sans la mémoire augmentée : ce jeu démarre à la place de Cartouche, et la console se ferme pendant qu’il tourne."
          }
        }
      }
    },
