    "work.stopped.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde außerhalb von Cartouche angehalten: über den Sperrbildschirm oder die Dynamic Island oder durch iOS. Starte es wieder, wann du willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was stopped outside Cartouche: from the Lock Screen or the Dynamic Island, or by iOS. Start it again whenever you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo fuera de Cartouche: desde la pantalla de bloqueo o la Dynamic Island, o por iOS. Vuelve a iniciarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a été arrêtée hors de Cartouche : depuis l’écran verrouillé ou la Dynamic Island, ou par iOS. Relancez-la quand vous voulez."
          }
        }
      }
    },
    "work.transfer.advice.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist langsam: Verbinde dieses iPhone per Kabel mit dem Mac oder bring beide in ein 5-GHz-WLAN, dann kommt das Spiel viel schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is slow: plug this iPhone into the Mac with a cable, or put both on a 5 GHz Wi-Fi, and the game comes much faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va lento: conecta este iPhone al Mac con un cable, o pon ambos en una red Wi-Fi de 5 GHz, y el juego llegará mucho más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est lent : branchez l’iPhone au Mac par un câble, ou mettez-les tous deux sur un Wi-Fi 5 GHz, et le jeu arrivera bien plus vite."
          }
        }
      }
    },
    "work.transfer.advice.macBand" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac ist in seinem 2,4-GHz-WLAN, dem langsamsten: Verbinde dieses iPhone per Kabel mit dem Mac oder bring den Mac ins 5-GHz-WLAN, dann kommt das Spiel viel schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is on its 2.4 GHz Wi-Fi, the slowest: plug this iPhone into the Mac with a cable, or put the Mac on the 5 GHz Wi-Fi, and the game comes much faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac está en su Wi-Fi de 2,4 GHz, la más lenta: conecta este iPhone al Mac con un cable, o pasa el Mac a la Wi-Fi de 5 GHz, y el juego llegará mucho más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac est sur le Wi-Fi 2,4 GHz, le plus lent : branchez l’iPhone au Mac par un câble, ou passez le Mac sur le Wi-Fi 5 GHz, et le jeu arrivera bien plus vite."
          }
        }
      }
    },
    "work.transfer.advice.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
