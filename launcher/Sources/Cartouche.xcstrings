    "signIn.otherCertificate" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Apple-ID hat bereits ein Zertifikat, das Cartouche nicht besitzt, erstellt von einer anderen App oder einem anderen Computer, und Cartouche widerruft es nie. Hast du Cartouche mit einer anderen Apple-ID installiert, melde dich mit dieser an. Sonst installiere Cartouche mit dem Cartouche-Installer auf deinem Computer erneut über diese Kopie, mit dieser Apple-ID: Er gibt Cartouche sein Zertifikat. Melde dich dann erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple ID already has a certificate that Cartouche does not hold, made by another app or computer, and Cartouche never revokes it. If you installed Cartouche with another Apple ID, sign in with that one. Otherwise, install Cartouche again over this copy with the Cartouche Installer on your computer, with this Apple ID: it gives Cartouche its certificate. Then sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ID de Apple ya tiene un certificado que Cartouche no tiene, creado por otra app u otro ordenador, y Cartouche nunca lo revoca. Si instalaste Cartouche con otro ID de Apple, inicia sesión con ese. Si no, vuelve a instalar Cartouche sobre esta copia con el Instalador de Cartouche en tu ordenador, con este ID de Apple: da a Cartouche su certificado. Luego vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet identifiant Apple a déjà un certificat que Cartouche n’a pas, créé par une autre app ou un autre ordinateur, et Cartouche ne le révoque jamais. Si vous avez installé Cartouche avec un autre identifiant Apple, connectez-vous avec celui-là. Sinon, réinstallez Cartouche par-dessus cette copie avec l’Installeur Cartouche sur votre ordinateur, avec cet identifiant Apple : il donne son certificat à Cartouche. Puis reconnectez-vous."
          }
        }
      }
    },
    "signIn.password" : {
      "extractionState" : "manual",
      "localizations" : {
