    "saves.running" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während das Spiel läuft, gehen seine Spielstände ein paar Sekunden nach jedem Speichern. Beende es, um jetzt zu synchronisieren oder eine Kopie zurückzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the game plays, its saves go a few seconds after each save. Quit it to sync now or put back a copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el juego está en marcha, sus partidas guardadas se envían unos segundos después de cada guardado. Sal de él para sincronizar ahora o restaurar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la partie, ses sauvegardes partent quelques secondes après chaque sauvegarde. Quittez le jeu pour synchroniser maintenant ou remettre une copie."
          }
        }
      }
    },
