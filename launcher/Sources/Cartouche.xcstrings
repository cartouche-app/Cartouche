          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vrac ou chacun dans son dossier, jusqu’à %lld dossiers plus bas. Un nom sans ID du titre convient aussi : Cartouche sur le Mac le lit alors à l’intérieur, ce qui demande vos prod.keys pour un paquet."
          }
        }
      }
    },
