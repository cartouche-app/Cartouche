    "switchSave.import.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel auf deiner Switch sollte nicht neuer sein als das dieses iPhone: Ein Spiel kann den Spielstand einer neueren Version vielleicht nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game on your Switch should not be newer than this iPhone’s: a game may not read the save of a newer version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego de tu Switch no debería ser más nuevo que el de este iPhone: un juego puede no leer la partida guardada de una versión más nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu de votre Switch ne doit pas être plus récent que celui de cet iPhone : un jeu ne lit pas toujours la sauvegarde d’une version plus récente."
          }
        }
      }
    },
