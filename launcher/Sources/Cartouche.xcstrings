      }
    },
    "signIn.device.noAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone hat über LocalDevVPN nicht geantwortet. Trenne LocalDevVPN, verbinde es erneut und versuche es noch einmal. Passiert es wieder, starte dieses iPhone neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone did not answer through LocalDevVPN. Disconnect LocalDevVPN, connect it again, then try again. If it happens again, restart this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no respondió a través de LocalDevVPN. Desconecta LocalDevVPN, vuelve a conectarlo y vuelve a intentarlo. Si vuelve a pasar, reinicia este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n’a pas répondu par LocalDevVPN. Déconnectez LocalDevVPN, reconnectez-le, puis réessayez. Si cela recommence, redémarrez cet iPhone."
          }
        }
      }
    },
    "signIn.device.olderPairing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopplungsdatei dieses iPhones ist von einer älteren Art, die Cartouche seit iOS 26.4 auf diesem iPhone nicht mehr verwenden kann. Wähle auf deinem Computer im Cartouche-Installer „Kopplungsdatei erneut in Cartouche ablegen“: Er erstellt eine der neueren Art."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone’s pairing file is of an older kind, which Cartouche can no longer use on this iPhone since iOS 26.4. On your computer, choose Put the pairing file in Cartouche again in the Cartouche Installer: it makes one of the newer kind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de emparejamiento de este iPhone es de un tipo antiguo, que Cartouche ya no puede usar en este iPhone desde iOS 26.4. En tu ordenador, elige Volver a poner el archivo de emparejamiento en Cartouche en el Instalador de Cartouche: crea uno del tipo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de jumelage de cet iPhone est d’un type plus ancien, que Cartouche ne peut plus utiliser sur cet iPhone depuis iOS 26.4. Sur votre ordinateur, choisissez Remettre le fichier de jumelage dans Cartouche dans l’Installeur Cartouche : il en fait un du type récent."
          }
        }
      }
    },
    "signIn.device.pairing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone hat seine Kopplungsdatei nicht akzeptiert. Lege die Kopplungsdatei mit dem Cartouche-Installer auf deinem Computer erneut in Cartouche ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone did not accept its pairing file. Put the pairing file in Cartouche again with the Cartouche Installer, on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no aceptó su archivo de emparejamiento. Vuelve a poner el archivo de emparejamiento en Cartouche con el Instalador de Cartouche, en tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n’a pas accepté son fichier de jumelage. Remettez le fichier de jumelage dans Cartouche avec l’Installeur Cartouche, sur votre ordinateur."
          }
        }
      }
    },
    "signIn.device.pairingRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone hat seine Kopplungsdatei abgelehnt, erstellt, bevor es deinem Computer nicht mehr vertraute, oder für ein anderes Gerät. Wähle auf deinem Computer in den Einstellungen des Cartouche-Installers „Gespeicherte Kopplung löschen“, wähle dieses iPhone erneut, dann „Kopplungsdatei erneut in Cartouche ablegen“, und tippe auf diesem iPhone auf „Vertrauen“, wenn es fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone refused its pairing file, made before it stopped trusting your computer, or for another device. On your computer, in the Cartouche Installer’s Settings, choose Delete the stored pairing, choose this iPhone again, then Put the pairing file in Cartouche again, and tap Trust on this iPhone when it asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone rechazó su archivo de emparejamiento, creado antes de que dejara de confiar en tu ordenador, o para otro dispositivo. En tu ordenador, en Ajustes del Instalador de Cartouche, elige Borrar el emparejamiento guardado, vuelve a elegir este iPhone, luego Volver a poner el archivo de emparejamiento en Cartouche, y toca Confiar en este iPhone cuando lo pida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone a refusé son fichier de jumelage, fait avant qu’il cesse de se fier à votre ordinateur, ou pour un autre appareil. Sur votre ordinateur, dans les Réglages de l’Installeur Cartouche, choisissez Supprimer le jumelage enregistré, choisissez de nouveau cet iPhone, puis Remettre le fichier de jumelage dans Cartouche, et touchez Se fier sur cet iPhone quand il le demande."
          }
        }
      }
    },
    "signIn.device.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzter Schritt: dieses iPhone"
          }
        },
        "en" : {
