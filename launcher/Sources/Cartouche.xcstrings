    "storage.gameFiles.loose" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Dateien von Spielen, aber keine IPA hier wurde dazu erstellt. Lege neben jede die IPA, die nxnative damit erstellt hat, oder erstelle die Spiele mit Cartouche auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: games’ files, but no IPA here was built to go with them. Put beside each the IPA nxnative built with it, or build the games with Cartouche on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: archivos de juegos, pero ninguna IPA de aquí se compiló para ir con ellos. Pon junto a cada uno la IPA que nxnative compiló con él, o compila los juegos con Cartouche en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : les fichiers de jeux, mais aucune IPA d’ici n’a été construite pour aller avec. Mettez à côté de chacun l’IPA que nxnative a construite avec, ou construisez les jeux avec Cartouche sur votre Mac."
          }
        }
      }
    },
