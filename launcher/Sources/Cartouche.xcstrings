    "settings.cloud.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner in iCloud Drive und denselben in „Spielstände in der Cloud“ der Mac-App. Der Spielstand kommt beim Start des Spiels und geht nach jedem Speichern hinaus; ein ersetzter Spielstand wird in save-backups aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder in iCloud Drive, and the same one in the Mac app’s Cloud saves. The save comes in when the game starts and goes out after each save; a save that is replaced is kept in save-backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta en iCloud Drive, y la misma en Partidas en la nube de la app del Mac. La partida llega cuando se inicia el juego y sale tras cada guardado; una partida que se sustituye se guarda en save-backups."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier dans iCloud Drive, et le même dans Cloud saves, dans l’app Mac. La sauvegarde arrive quand le jeu démarre et repart après chaque sauvegarde ; une sauvegarde remplacée est gardée dans save-backups."
          }
        }
      }
    },
