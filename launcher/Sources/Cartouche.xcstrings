        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Account deines Servers, etwa deines NAS oder deines Mac (Entfernte Anmeldung). Cartouche merkt sich beim Sichern den Schlüssel des Servers und lehnt danach jeden anderen Schlüssel ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account of your server, such as your NAS’s or your Mac’s (Remote Login). Cartouche keeps the server’s key when you save it, and refuses any other key afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de tu servidor, como la de tu NAS o tu Mac (Sesión remota). Cartouche guarda la clave del servidor al guardarlo, y rechaza cualquier otra clave después."
          }
        },
        "fr" : {
