    "system.memory.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Spiele teilen sich dieses Limit. Mit dem erhöhten Speicherlimit gewährt ein iPhone mit 12 GB Cartouche etwa 8 GiB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your games share this limit. With Increased Memory Limit, an iPhone with 12 GB allows Cartouche about 8 GiB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus juegos comparten este límite. Con la memoria ampliada, un iPhone de 12 GB da a Cartouche unos 8 GiB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jeux partagent cette limite. Avec la mémoire augmentée, un iPhone de 12 Go accorde environ 8 Gio à Cartouche."
          }
        }
      }
    },
