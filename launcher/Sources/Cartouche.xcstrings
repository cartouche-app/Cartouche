    "switchSave.import.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere auf deiner Switch den Spielstand dieses Spiels mit JKSV oder Checkpoint und lege dann seinen Ordner oder seine ZIP auf dieses iPhone, in „Dateien“: von der microSD-Karte mit einem USB-C-Lesegerät, über iCloud Drive oder von deinem NAS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Switch, export this game’s save with JKSV or Checkpoint, then put its folder or its ZIP on this iPhone, in Files: from the microSD card with a USB-C reader, through iCloud Drive or from your NAS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu Switch, exporta la partida guardada de este juego con JKSV o Checkpoint y luego pon su carpeta o su ZIP en este iPhone, en Archivos: desde la tarjeta microSD con un lector USB-C, a través de iCloud Drive o desde tu NAS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre Switch, exportez la sauvegarde de ce jeu avec JKSV ou Checkpoint, puis mettez son dossier ou son ZIP sur cet iPhone, dans Fichiers : depuis la carte microSD avec un lecteur USB-C, par iCloud Drive ou depuis votre NAS."
          }
        }
      }
    },
    "switchSave.import.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ersetzt den Spielstand dieses Spiels auf diesem iPhone, den Cartouche hier behält: Du kannst ihn zurückspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It replaces this game’s save on this iPhone, which Cartouche keeps here: you can put it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye la partida guardada de este juego en este iPhone, que Cartouche conserva aquí: puedes restaurarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle remplace la sauvegarde de ce jeu sur cet iPhone, que Cartouche garde ici : vous pourrez la remettre."
          }
        }
      }
    },
    "switchSave.import.message.folder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ersetzt den Spielstand dieses Spiels auf diesem iPhone, den Cartouche hier behält: Du kannst ihn zurückspielen. Danach geht er als neueste Kopie in deinen Spielstandordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It replaces this game’s save on this iPhone, which Cartouche keeps here: you can put it back. It then goes to your saves folder, as the newest copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye la partida guardada de este juego en este iPhone, que Cartouche conserva aquí: puedes restaurarla. Luego va a tu carpeta de partidas guardadas, como la copia más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle remplace la sauvegarde de ce jeu sur cet iPhone, que Cartouche garde ici : vous pourrez la remettre. Elle part ensuite dans votre dossier des sauvegardes, comme la copie la plus récente."
          }
        }
      }
    },
