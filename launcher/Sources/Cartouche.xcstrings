    "storage.drive.weekly" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange dein Projekt im Test ist, beendet Google die Anmeldung nach 7 Tagen: Cartouche bittet dich dann, dich mit ein paar Fingertipps erneut anzumelden, und deine Spielstände warten so lange. Um dich ein für alle Mal anzumelden, veröffentliche die App unter „Zielgruppe“, wenn Google es anbietet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While your project is in testing, Google ends the sign-in after 7 days: Cartouche then asks you to sign in again, in a few taps, and your saves wait meanwhile. To sign in once for good, publish the app under Audience, when Google offers it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras tu proyecto está en pruebas, Google cierra la sesión tras 7 días: Cartouche te pide entonces volver a iniciar sesión, en unos toques, y mientras tanto tus partidas guardadas esperan. Para iniciar sesión de una vez por todas, publica la app en Público, cuando Google lo ofrezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que votre projet est en test, Google met fin à la connexion au bout de 7 jours : Cartouche vous demande alors de vous reconnecter, en quelques touches, et vos sauvegardes attendent. Pour vous connecter une fois pour toutes, publiez l’app dans Audience, si Google le propose."
          }
        }
      }
    },
