    "cloud.unlink.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpft liest dieses iPhone die Spiele deines Accounts und lädt die erstellten herunter, mehr nicht: Spiele senden, deine Credits und dein Account bleiben auf der Website."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linked, this iPhone reads your account’s games and fetches those built, nothing more: sending a game, your credits and your account stay on the site."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinculado, este iPhone lee los juegos de tu cuenta y descarga los compilados, nada más: enviar un juego, tus créditos y tu cuenta se quedan en el sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lié, cet iPhone lit les jeux de votre compte et récupère ceux qui sont construits, rien de plus : l’envoi d’un jeu, vos crédits et votre compte restent sur le site."
          }
        }
      }
    },
    "cloud.unlink.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche verfolgt die Spiele deines Accounts hier nicht mehr, und die Seite deines Accounts listet dieses iPhone nicht mehr. Die installierten Spiele bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche no longer follows your account’s games here, and your account’s page no longer lists this iPhone. The games installed stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche deja de seguir aquí los juegos de tu cuenta, y la página de tu cuenta deja de mostrar este iPhone. Los juegos instalados se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ne suit plus les jeux de votre compte ici, et la page de votre compte ne liste plus cet iPhone. Les jeux installés restent."
          }
        }
      }
    },
