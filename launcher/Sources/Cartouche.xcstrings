    "signing.zipFile" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist eine .zip. Tippe sie zuerst in der App „Dateien“ an, die sie als Ordner öffnet, und wähle dann die .p12-Datei in diesem Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file is a .zip. Tap it in the Files app first, which opens it as a folder, then choose the .p12 file in that folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo es un .zip. Tócalo primero en la app Archivos, que lo abre como carpeta, y luego elige el archivo .p12 de esa carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est un .zip. Touchez-le d’abord dans l’app Fichiers, qui l’ouvre en dossier, puis choisissez le fichier .p12 de ce dossier."
          }
        }
      }
    },
    "start.space" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Spielens hält das Spiel seinen Speicher in Dateien, die bis zu %1$@ belegen können, und dieses iPhone hat %2$@ frei. Schaffe zuerst Platz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it plays, the game keeps its memory in files, which can take up to %1$@, and this iPhone has %2$@ free. Free up some space first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras se juega, el juego guarda su memoria en archivos, que pueden ocupar hasta %1$@, y este iPhone tiene %2$@ libres. Libera espacio primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la partie, le jeu garde sa mémoire dans des fichiers, qui peuvent prendre jusqu’à %1$@, et cet iPhone a %2$@ de libre. Libérez d’abord de la place."
          }
        }
      }
    },
    "start.space.purgeable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Spielens hält das Spiel seinen Speicher in Dateien, die bis zu %1$@ belegen können, und dieses iPhone hat gerade %2$@ frei. iOS zählt %3$@ als verfügbar, gibt den Rest aber erst frei, wenn ihm selbst der Platz ausgeht, zu spät für das Spiel. Schaffe zuerst Platz, etwa die IPAs bereits installierter Spiele."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it plays, the game keeps its memory in files, which can take up to %1$@, and this iPhone has %2$@ free right now. iOS counts %3$@ as available, but frees the rest only once it runs short itself, too late for the game. Free up some space first, such as the IPAs of games already installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras se juega, el juego guarda su memoria en archivos, que pueden ocupar hasta %1$@, y este iPhone tiene %2$@ libres ahora mismo. iOS cuenta %3$@ como disponibles, pero solo libera el resto cuando a él mismo le falta, demasiado tarde para el juego. Libera espacio primero, por ejemplo los IPA de los juegos ya instalados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la partie, le jeu garde sa mémoire dans des fichiers, qui peuvent prendre jusqu’à %1$@, et cet iPhone a %2$@ de libre en ce moment. iOS compte %3$@ de disponible, mais ne libère le reste que quand il en manque lui-même, trop tard pour le jeu. Libérez d’abord de la place, par exemple les IPA des jeux déjà installés."
          }
        }
      }
    },
    "start.space.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ könnte sich wegen fehlenden Speicherplatzes schließen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ may close for lack of space"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podría cerrarse por falta de espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ risque de se fermer faute de place"
          }
        }
      }
    },
