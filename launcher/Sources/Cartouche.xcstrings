    "updates.offer.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Version %@. Cartouche installiert die neue ohne Computer, über LocalDevVPN, und schließt sich dann: Öffne es wieder. Deine Spiele und Spielstände bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have version %@. Cartouche installs the new one without a computer, through LocalDevVPN, then closes: open it again. Your games and saves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la versión %@. Cartouche instala la nueva sin ordenador, a través de LocalDevVPN, y luego se cierra: vuelve a abrirlo. Tus juegos y tus partidas guardadas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez la version %@. Cartouche installe la nouvelle sans ordinateur, par LocalDevVPN, puis se ferme : rouvrez-le. Vos jeux et sauvegardes restent."
          }
        }
      }
    },
