    "report.send.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende ihn per Nachrichten, Mail oder AirDrop an die Person, die dir hilft. Auf GitHub prüfst und veröffentlichst du ihn selbst: Dort ist er öffentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it by Messages, Mail or AirDrop to whoever helps you. On GitHub, you check it and post it yourself: it is public there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíalo por Mensajes, Mail o AirDrop a quien te ayude. En GitHub, lo revisas y lo publicas tú: allí es público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez-le par Messages, Mail ou AirDrop à qui vous aide. Sur GitHub, vous le vérifiez et le publiez vous-même : il y est public."
          }
        }
      }
    },
    "report.send.footer.server" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„An Cartouche senden“ gibt ihn privat an das Projekt weiter. Oder sende ihn per Nachrichten, Mail oder AirDrop an die Person, die dir hilft. Auf GitHub prüfst und veröffentlichst du ihn selbst: Dort ist er öffentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send to Cartouche passes it to the project, privately. Or send it by Messages, Mail or AirDrop to whoever helps you. On GitHub, you check it and post it yourself: it is public there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar a Cartouche lo pasa al proyecto, en privado. O envíalo por Mensajes, Mail o AirDrop a quien te ayude. En GitHub, lo revisas y lo publicas tú: allí es público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Envoyer à Cartouche » le transmet au projet, en privé. Ou envoyez-le par Messages, Mail ou AirDrop à qui vous aide. Sur GitHub, vous le vérifiez et le publiez vous-même : il y est public."
          }
        }
      }
    },
