    "storage.drive.account.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google bittet dich, deinem Client das Ansehen, Bearbeiten und Löschen der Dateien deines Drive zu erlauben: Cartouche installiert deine Spiele von dort und bewahrt deine Spielstände dort auf, nur in „Meine Ablage“. Deine Anmeldung bleibt im Schlüsselbund dieses iPhones."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google asks you to let your client see, edit and delete the files of your Drive: Cartouche installs your games from there and keeps your saves there, in My Drive alone. Your sign-in stays in this iPhone’s keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google te pide que permitas a tu cliente ver, editar y borrar los archivos de tu Drive: Cartouche instala tus juegos desde allí y guarda allí tus partidas, solo en Mi unidad. Tu inicio de sesión se queda en el llavero de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google vous demande de laisser votre client voir, modifier et supprimer les fichiers de votre Drive : Cartouche y installe vos jeux et y garde vos sauvegardes, dans Mon Drive seulement. Votre connexion reste dans le trousseau de cet iPhone."
          }
        }
      }
    },
