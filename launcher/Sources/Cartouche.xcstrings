    "storage.servers.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eigener Speicher, mit deinem eigenen Account: Cartouche bewahrt das Passwort, den geheimen Schlüssel oder die Google-Anmeldung im Schlüsselbund dieses iPhones auf. Der Mac, den du koppelst, behält dieselben Verbindungen, Passwörter inklusive, über die Verschlüsselung der Brücke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only storage of your own, with your own account: Cartouche keeps the password, the secret key or the Google sign-in in this iPhone’s keychain. The Mac you pair keeps the same connections, passwords included, over the bridge’s encryption."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo almacenamiento tuyo, con tu propia cuenta: Cartouche guarda la contraseña, la clave secreta o el inicio de sesión de Google en el llavero de este iPhone. El Mac que emparejas guarda las mismas conexiones, contraseñas incluidas, con el cifrado del puente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement votre propre stockage, avec votre propre compte : Cartouche garde le mot de passe, la clé secrète ou la connexion Google dans le trousseau de cet iPhone. Le Mac que vous associez garde les mêmes connexions, mots de passe compris, par le chiffrement du pont."
          }
        }
      }
    },
