    "cloud.cause.build" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative konnte dieses Spiel nicht erstellen. Das passiert bei manchen Spielen und manchen ihrer Versionen: Nach einem Update von nxnative klappt es vielleicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative did not manage to build this game. This happens with some games and some of their versions: it may build after an update of nxnative."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative no consiguió compilar este juego. Pasa con algunos juegos y algunas de sus versiones: puede que se compile tras una actualización de nxnative."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative n’est pas parvenu à construire ce jeu. Cela arrive pour certains jeux et certaines de leurs versions : il pourra se construire après une mise à jour de nxnative."
          }
        }
      }
    },
    "cloud.cause.ipa" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Build endete ohne die App, die er erstellen sollte."
          }
        },
        "en" : {
          "stringUnit" : {
