    "work.install.damaged" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese IPA ist beschädigt: Sie endet zu früh, oder eine ihrer Dateien hat sich seit ihrer Erstellung geändert, etwa wenn eine Kopie vor dem Ende abbricht oder schiefgeht. Kopiere sie erneut von ihrer Quelle und installiere sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This IPA is damaged: it ends early, or one of its files changed since it was made, as when a copy stops before the end or goes wrong. Copy it again from where it came from, then install it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta IPA está dañada: termina antes de tiempo, o uno de sus archivos cambió desde que se creó, como cuando una copia se detiene antes del final o sale mal. Vuelve a copiarla desde su origen y vuelve a instalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette IPA est abîmée : elle s’arrête avant la fin, ou l’un de ses fichiers a changé depuis sa création, comme quand une copie s’interrompt ou se passe mal. Copiez-la de nouveau depuis son origine, puis installez-la de nouveau."
          }
        }
      }
    },
