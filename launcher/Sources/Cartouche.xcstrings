        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el certificado (.p12) con el que tu app de firma firmó Cartouche y escribe su contraseña. Cartouche lee su perfil solo. No hace falta ni ID de Apple ni LocalDevVPN."
          }
        },
        "fr" : {
          "stringUnit" : {
