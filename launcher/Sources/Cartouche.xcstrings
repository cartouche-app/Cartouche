    "telemetry.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jedem Spiel sendet Cartouche, was nxnative während des Laufens gemessen hat, zusammen mit den eigenen Ereignissen von Cartouche. Sie zeigen, welche Spiele auf welchem iPhone gut laufen und was zu beheben ist."
          }
