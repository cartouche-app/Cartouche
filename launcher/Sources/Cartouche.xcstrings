    "guide.folder.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche auf dem Mac legt deine Spiele in einen Ordner, auf dem Mac oder auf deinem NAS. Füge deinen Mac hier einmal hinzu, mit dem Code, den beide Bildschirme zeigen, oder wähle den Ordner auf deinem NAS: Cartouche listet deine Spiele und bietet ihre Updates an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche on the Mac puts your games in a folder, on the Mac or on your NAS. Add your Mac here once, with the code both screens show, or choose the folder on your NAS: Cartouche lists your games and offers their updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche en el Mac pone tus juegos en una carpeta, en el Mac o en tu NAS. Añade tu Mac aquí una vez, con el código que muestran ambas pantallas, o elige la carpeta de tu NAS: Cartouche muestra tus juegos y te ofrece sus actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
