    "signing.unreadableKey" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kann diese .p12 nicht lesen: Sie ist vielleicht beschädigt oder unvollständig. Lade oder kopiere sie erneut und wähle sie dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS cannot read this .p12: it may be damaged or incomplete. Download or copy it again, then choose it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
