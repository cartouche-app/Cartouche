    "switchSave.problem.case" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei seiner Dateien unterscheiden sich nur in der Groß- und Kleinschreibung, %1$@ und %2$@: Das iPhone kann nicht beide behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two of its files differ only by their capitals, %1$@ and %2$@: the iPhone cannot keep both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos de sus archivos solo se distinguen por las mayúsculas, %1$@ y %2$@: el iPhone no puede conservar ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux de ses fichiers ne diffèrent que par leurs majuscules, %1$@ et %2$@ : l’iPhone ne peut pas garder les deux."
          }
        }
      }
    },
