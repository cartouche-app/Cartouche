    "storage.drive.guide.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal, kostenlos, in Google Cloud, mit dem Google-Konto deines Drive: auf diesem iPhone oder auf einem Computer, wo es einfacher ist. Jede Taste öffnet die Seite ihres Schritts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once, for free, in Google Cloud, with the Google account of your Drive: on this iPhone, or on a computer, where it is easier. Each button opens its step’s page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez, gratis, en Google Cloud, con la cuenta de Google de tu Drive: en este iPhone o en un ordenador, donde es más fácil. Cada botón abre la página de su paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois, gratuitement, dans Google Cloud, avec le compte Google de votre Drive : sur cet iPhone, ou sur un ordinateur, où c’est plus simple. Chaque bouton ouvre la page de son étape."
          }
        }
      }
    },
