          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple accepted your Apple ID: only this iPhone is left to register, which Cartouche does by itself once LocalDevVPN is connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
