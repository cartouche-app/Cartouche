        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After each game, Cartouche sends what nxnative measured while it ran, with Cartouche’s own events. They show which games run well on which iPhone, and what to fix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cada partida, Cartouche envía lo que nxnative midió mientras funcionaba, con los propios eventos de Cartouche. Muestran qué juegos funcionan bien en qué iPhone, y qué hay que arreglar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque partie, Cartouche envoie ce que nxnative a mesuré pendant le jeu, avec ses propres événements. Ils montrent quels jeux tournent bien sur quel iPhone, et ce qu’il faut corriger."
          }
        }
      }
