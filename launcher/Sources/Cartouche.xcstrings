    "naming.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche erkennt ein Spiel auf dem iPhone wie auf dem Mac an seiner Title-ID: den 16 Buchstaben und Ziffern in eckigen Klammern in seinem Namen, so wie es benennt, was es schreibt. Die Infoseite eines Spiels zeigt seine Title-ID."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche, on the iPhone as on the Mac, knows a game by its title ID: the 16 letters and digits in square brackets in its name, as it names what it writes. A game’s sheet shows its title ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche, en el iPhone como en el Mac, reconoce un juego por su ID de título: las 16 letras y cifras entre corchetes de su nombre, igual que nombra lo que escribe. La ficha de un juego muestra su ID de título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche, sur l’iPhone comme sur le Mac, reconnaît un jeu à son ID du titre : les 16 lettres et chiffres entre crochets dans son nom, comme il nomme ce qu’il écrit. La fiche d’un jeu montre son ID du titre."
          }
        }
      }
    },
