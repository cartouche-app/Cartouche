    "signIn.provisioningRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lehnt es derzeit ab, eine neue Anmeldung auf diesem iPhone einzurichten (%lld), noch bevor deine Apple-ID gesendet wird. Es gibt nichts zurückzusetzen oder neu zu installieren. Warte, bis der Countdown abgelaufen ist, und melde dich dann erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple is refusing, for now, to set up a new sign-in on this iPhone (%lld), before your Apple ID is even sent. There is nothing to reset or reinstall. Wait for the countdown to end, then sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple se niega, por ahora, a preparar un nuevo inicio de sesión en este iPhone (%lld), antes incluso de que se envíe tu ID de Apple. No hay nada que restablecer ni reinstalar. Espera a que termine la cuenta atrás y vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple refuse pour l’instant de préparer une nouvelle connexion sur cet iPhone (%lld), avant même l’envoi de votre identifiant Apple. Il n’y a rien à réinitialiser ni à réinstaller. Attendez la fin du compte à rebours, puis reconnectez-vous."
          }
        }
      }
    },
    "signIn.sessionExpired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple meldet, dass die Anmeldung dieses iPhones abgelaufen ist (1100). Es gibt nichts zurückzusetzen oder neu zu installieren: Melde dich erneut an und gib den Code ein, den Apple sendet, falls danach gefragt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple says this iPhone’s sign-in has expired (1100). There is nothing to reset or reinstall: sign in again, and type the code Apple sends if it asks for one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dice que el inicio de sesión de este iPhone ha caducado (1100). No hay nada que restablecer ni reinstalar: vuelve a iniciar sesión y escribe el código que envíe Apple si lo pide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dit que la connexion de cet iPhone a expiré (1100). Il n’y a rien à réinitialiser ni à réinstaller : reconnectez-vous, et saisissez le code qu’Apple envoie s’il en demande un."
          }
        }
      }
    },
    "signIn.sideStoreQuit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der integrierte SideStore wurde vor dem Ende geschlossen. Starte dieses iPhone neu und versuche es erneut. Schließt er sich wieder, installiere das unter Einstellungen › Allgemein › Softwareupdate angebotene Update, falls es eines gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The built-in SideStore closed before it finished. Restart this iPhone, then try again. If it closes again, install the update offered in Settings › General › Software Update, if there is one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El SideStore integrado se cerró antes de terminar. Reinicia este iPhone y vuelve a intentarlo. Si se vuelve a cerrar, instala la actualización que se ofrezca en Ajustes › General › Actualización de software, si la hay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le SideStore intégré s’est fermé avant d’avoir fini. Redémarrez cet iPhone, puis réessayez. S’il se ferme encore, installez la mise à jour proposée dans Réglages › Général › Mise à jour logicielle, s’il y en a une."
          }
        }
      }
    },
