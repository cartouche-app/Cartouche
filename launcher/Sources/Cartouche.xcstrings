    "saves.noFolder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Spielstandordner unter System › Speicher: Cartouche hält die Spielstände dieses Spiels damit synchron und holt sie zurück, wenn Cartouche erneut installiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a saves folder in System › Storage: Cartouche will keep this game’s saves in step with it, and bring them back if Cartouche is installed again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta de partidas guardadas en Sistema › Almacenamiento: Cartouche mantendrá las partidas de este juego al compás de ella, y las recuperará si se vuelve a instalar Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier des sauvegardes dans Système › Stockage : Cartouche y synchronisera les sauvegardes de ce jeu, et les remettra si Cartouche est réinstallé."
          }
        }
      }
    },
