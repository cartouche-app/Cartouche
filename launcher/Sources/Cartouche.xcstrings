    "storage.mac.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ antwortet in diesem Netzwerk nicht. Öffne dort Cartouche mit eingeschaltetem „Mit Cartouche auf dem iPhone teilen“: Cartouche versucht es erneut, sobald das iPhone wieder in seinem WLAN oder in deinem VPN ist oder per Kabel daran angeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not answer on this network. Open Cartouche on it with Share with Cartouche on the iPhone turned on: Cartouche tries again as soon as the iPhone is back on its Wi-Fi or on your VPN, or plugged into it with a cable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde en esta red. Abre Cartouche en él con Compartir con Cartouche en el iPhone activado: Cartouche vuelve a intentarlo en cuanto el iPhone vuelva a su red Wi-Fi o a tu VPN, o esté conectado a él con un cable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas sur ce réseau. Ouvrez-y Cartouche avec Partager avec Cartouche sur l’iPhone activé : Cartouche réessaie dès que l’iPhone retrouve son Wi-Fi ou votre VPN, ou y est branché avec un câble."
          }
        }
      }
    },
