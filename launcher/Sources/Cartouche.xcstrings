          }
        }
      }
    },
    "signing.updateOnComputer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ist mit deinem eigenen Zertifikat signiert: Installiere seine Updates und vor dem Ablauf ein neues Zertifikat über den Cartouche-Installer auf deinem Computer. Es braucht keine wöchentliche Erneuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche is signed with your own certificate: install its updates, and a new certificate before it expires, from the Cartouche Installer on your computer. It needs no renewal each week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche está firmado con tu propio certificado: instala sus actualizaciones, y un certificado nuevo antes de que caduque, desde el Instalador de Cartouche en tu ordenador. No necesita renovarse cada semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche est signé avec votre propre certificat : installez ses mises à jour, et un nouveau certificat avant qu’il n’expire, depuis l’Installeur Cartouche sur votre ordinateur. Il n’a pas besoin d’être renouvelé chaque semaine."
          }
        }
      }
    },
    "signing.updateOnIPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche ist mit deinem eigenen Zertifikat signiert und braucht keine wöchentliche Erneuerung. Erscheint eine neue Version, sagt Cartouche es dir: Lade sie herunter, signiere sie wie beim ersten Mal in deiner Signier-App und installiere sie dann über diese. Deine Spiele und Spielstände bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche is signed with your own certificate and needs no renewal each week. When a new version is out, Cartouche says so: download it, sign it in your signing app as the first time, then install it over this one. Your games and saves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche está firmado con tu propio certificado y no necesita renovarse cada semana. Cuando sale una nueva versión, Cartouche lo dice: descárgala, fírmala en tu app de firma como la primera vez e instálala sobre esta. Tus juegos y tus partidas guardadas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche est signé avec votre propre certificat et n’a pas besoin d’être renouvelé chaque semaine. Quand une nouvelle version sort, Cartouche le dit : téléchargez-la, signez-la dans votre app de signature comme la première fois, puis installez-la par-dessus celle-ci. Vos jeux et sauvegardes restent."
          }
        }
      }
    },
