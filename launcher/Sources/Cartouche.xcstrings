    "system.playing.noIML" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter Cartouche laufen Spiele hier ohne das erhöhte Speicherlimit: Sie starten anstelle von Cartouche, mit seinem ganzen Arbeitsspeicher, außer ihre Infoseite zeigt, dass sie weniger brauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behind Cartouche, games run without Increased Memory Limit here: they start in Cartouche’s place, with all of its memory, unless their sheet shows they need less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detrás de Cartouche, los juegos funcionan aquí sin la memoria ampliada: se inician en lugar de Cartouche, con toda su memoria, salvo que su ficha muestre que necesitan menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrière Cartouche, les jeux tournent ici sans la mémoire augmentée : ils démarrent à la place de Cartouche, avec toute sa mémoire, sauf si leur fiche montre qu’il leur en faut moins."
          }
        }
      }
    },
