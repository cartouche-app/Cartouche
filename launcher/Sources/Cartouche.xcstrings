    "signIn.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal auf diesem iPhone: Cartouche registriert es bei deinem Account, holt sein Zertifikat und erneuert sich jede Woche, ohne dich erneut zu fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
