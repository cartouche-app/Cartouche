          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharper ground and walls seen at an angle. 16x costs little on a Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelo y paredes más nítidos vistos en ángulo. 16x cuesta poco en un Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
