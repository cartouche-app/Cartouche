    "app.noLiveProcess" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kopie von Cartouche fehlt der Teil der App, in dem der integrierte SideStore läuft (LiveProcess): Ohne ihn kann sich Cartouche weder mit deiner Apple-ID anmelden noch sich erneuern oder aktualisieren. Installiere Cartouche mit dem Cartouche-Installer auf deinem Computer erneut über diese Kopie, mit derselben Apple-ID: Er fügt diesen Teil wieder hinzu. Deine Spiele und Spielstände bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of Cartouche is missing the part of the app the built-in SideStore runs in (LiveProcess): without it, Cartouche can neither sign in to your Apple ID, nor renew or update itself. Install Cartouche again over this copy with the Cartouche Installer, on your computer, with the same Apple ID: it puts that part back. Your games and saves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A esta copia de Cartouche le falta la parte de la app en la que funciona el SideStore integrado (LiveProcess): sin ella, Cartouche no puede iniciar sesión con tu ID de Apple, ni renovarse, ni actualizarse. Vuelve a instalar Cartouche sobre esta copia con el Instalador de Cartouche, en tu ordenador, con el mismo ID de Apple: devuelve esa parte. Tus juegos y tus partidas guardadas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à cette copie de Cartouche la partie de l’app où tourne le SideStore intégré (LiveProcess) : sans elle, Cartouche ne peut ni se connecter à votre identifiant Apple, ni se renouveler, ni se mettre à jour. Réinstallez Cartouche par-dessus cette copie avec l’Installeur Cartouche, sur votre ordinateur, avec le même identifiant Apple : il remet cette partie. Vos jeux et vos sauvegardes restent."
          }
        }
      }
    },
    "apple.page" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Server von Apple haben statt einer Antwort eine Fehlerseite (%lld) gesendet. Versuche es in ein paar Minuten erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’s servers sent back an error page (%lld) instead of an answer. Try again in a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores de Apple devolvieron una página de error (%lld) en lugar de una respuesta. Vuelve a intentarlo dentro de unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs d’Apple ont renvoyé une page d’erreur (%lld) au lieu d’une réponse. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "apple.provisioningRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lehnt es derzeit ab, eine neue Anmeldung auf diesem iPhone einzurichten (%lld). Warte eine Weile und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple is refusing, for now, to set up a new sign-in on this iPhone (%lld). Wait a while, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple se niega, por ahora, a preparar un nuevo inicio de sesión en este iPhone (%lld). Espera un rato y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple refuse pour l’instant de préparer une nouvelle connexion sur cet iPhone (%lld). Patientez un moment, puis réessayez."
          }
        }
      }
    },
    "apple.tooManyRequests" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lehnt vorerst weitere Anfragen ab, nachdem in kurzer Zeit zu viele von dieser Apple-ID oder aus diesem Netzwerk kamen. Warte eine Weile und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple is refusing more requests for now, after too many in a short time from this Apple ID or from this network. Wait a while, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple rechaza más solicitudes por ahora, tras demasiadas en poco tiempo desde este ID de Apple o desde esta red. Espera un rato y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple refuse d’autres demandes pour l’instant, après trop de demandes en peu de temps pour cet identifiant Apple ou depuis ce réseau. Patientez un moment, puis réessayez."
          }
        }
      }
    },
    "apple.unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche konnte die Antwort von Apple nicht lesen. Prüfe die Verbindung dieses iPhones und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche could not read Apple’s answer. Check this iPhone’s connection, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche no pudo leer la respuesta de Apple. Comprueba la conexión de este iPhone y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche n’a pas pu lire la réponse d’Apple. Vérifiez la connexion de cet iPhone, puis réessayez."
          }
        }
      }
    },
