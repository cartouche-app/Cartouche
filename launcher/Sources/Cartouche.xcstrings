    "report.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verlässt dieses iPhone nur, wenn du ihn sendest, ohne Passwörter, Servernamen oder -adressen, Benutzernamen, Apple-ID oder Team, auch nicht in dem, was du schreibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaves this iPhone only when you send it, without passwords, server names or addresses, user names, Apple ID or team, even in what you write."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sale de este iPhone cuando lo envías, sin contraseñas, nombres ni direcciones de servidores, nombres de usuario, ID de Apple ni equipo, ni siquiera en lo que escribas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne quitte cet iPhone que si vous l’envoyez, sans mots de passe, noms ni adresses de serveurs, noms d’utilisateur, identifiant Apple ni équipe, même dans ce que vous écrivez."
          }
        }
      }
