    "saves.putBack.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie zurückzuspielen ersetzt die Spielstände dieses Spiels auf diesem iPhone. Cartouche sendet die aktuellen zuerst in deinen Spielstandordner, und die zurückgespielte Kopie wird dort zur neuesten, die auch deine anderen iPhones übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putting back a copy replaces this game’s saves on this iPhone. Cartouche sends the current ones to your saves folder first, and the copy put back becomes the newest one there, which your other iPhones take too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar una copia sustituye las partidas guardadas de este juego en este iPhone. Cartouche envía antes las actuales a tu carpeta de partidas guardadas, y la copia restaurada pasa a ser allí la más reciente, que también toman tus otros iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remettre une copie remplace les sauvegardes de ce jeu sur cet iPhone. Cartouche envoie d’abord les actuelles dans votre dossier des sauvegardes, et la copie remise y devient la plus récente, que vos autres iPhone prennent aussi."
          }
        }
      }
    },
    "saves.putBack.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ersetzt die Spielstände des Spiels auf diesem iPhone. Cartouche sendet sie zuerst in deinen Spielstandordner, damit du zu ihnen zurückkehren kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It replaces the game’s saves on this iPhone. Cartouche sends them to your saves folder first, so you can come back to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye las partidas guardadas del juego en este iPhone. Cartouche las envía antes a tu carpeta de partidas guardadas, para que puedas volver a ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle remplace les sauvegardes du jeu sur cet iPhone. Cartouche les envoie d’abord dans votre dossier des sauvegardes : vous pourrez y revenir."
          }
        }
      }
    },
