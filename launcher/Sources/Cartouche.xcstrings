    "storage.games.several.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bibliothek zeigt die IPAs dieser Ordner, bereit zur Installation: Ein Spiel in mehreren erscheint einmal und wird aus einem Ordner installiert, der antwortet. Kopiere ein Spiel in den ersten, bevor du es deinstallierst."
