    "saves.newerGame" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neueste Kopie dieser Spielstände stammt aus Version %1$@ des Spiels, neuer als die hier installierte (%2$@): Sie kommt, sobald das Spiel aktualisiert ist. Bis dahin gehen die hier gespielten Spielstände als eigene Kopie in deinen Spielstandordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The newest copy of these saves comes from version %1$@ of the game, newer than the one installed here (%2$@): it comes once the game is updated. Until then, the saves played here go to your saves folder as a copy of their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia más reciente de estas partidas guardadas viene de la versión %1$@ del juego, más nueva que la instalada aquí (%2$@): llega cuando se actualice el juego. Hasta entonces, las partidas jugadas aquí van a tu carpeta de partidas guardadas como una copia aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie la plus récente de ces sauvegardes vient de la version %1$@ du jeu, plus récente que celle installée ici (%2$@) : elle viendra une fois le jeu mis à jour. D’ici là, les sauvegardes jouées ici partent dans votre dossier des sauvegardes comme une copie à part."
          }
        }
      }
    },
