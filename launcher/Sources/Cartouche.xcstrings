      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code verknüpft nichts: Er ist vielleicht falsch eingegeben, seine zehn Minuten sind abgelaufen, oder er wurde schon verwendet. Die Seite deines Accounts gibt dir einen neuen."
          }
        },
