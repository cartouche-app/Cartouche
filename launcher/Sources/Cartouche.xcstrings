    "telemetry.what.device" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell, iOS-Version, Sprache und Speicherlimit dieses iPhones, Version und Sprache von Cartouche sowie eine Zufallsnummer dieser Kopie von Cartouche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone’s model, iOS version, language and memory limit, Cartouche’s version and language, and a random number of this copy of Cartouche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo, la versión de iOS, el idioma y el límite de memoria de este iPhone, la versión y el idioma de Cartouche, y un número aleatorio de esta copia de Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle de cet iPhone, sa version d’iOS, sa langue et sa limite de mémoire, la version et la langue de Cartouche, et un numéro tiré au hasard pour cette copie de Cartouche."
          }
        }
      }
    },
    "telemetry.what.events" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Start von Cartouche, Installationen von Spielen, Updates, Erneuerungen, Zurücksetzungen, Anmeldungen mit der Apple-ID, importierte Signierzertifikate, wie die Auswahl in „Dateien“ bei jedem Import verlief, und Fehler, nach ihren Codes und dem Schritt, bei dem sie anhielten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each start of Cartouche, game installs, updates, renewals, resets, Apple ID sign-ins, signing certificates you import, how the Files picker of each import went, and errors, by their codes and the step they stopped at."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inicio de Cartouche, instalaciones de juegos, actualizaciones, renovaciones, restablecimientos, inicios de sesión con el ID de Apple, certificados de firma que importas, cómo fue el selector de Archivos en cada importación, y los errores, por sus códigos y el paso en que se detuvieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ouverture de Cartouche, les installations de jeux, les mises à jour, les renouvellements, les réinitialisations, les connexions au compte Apple, les certificats de signature importés, le déroulement du sélecteur de fichiers de chaque import et les erreurs, par leurs codes et l’étape où elles se sont arrêtées."
          }
        }
      }
    },
    "telemetry.what.games" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jede Spielsitzung: Bildrate, Bild- und GPU-Zeiten, Ruckler und ihre Ursache, Shader-Vorbereitung, Arbeitsspeicher, Wärme und Energie, Ton, die Bildschirmgrößen, wie das Spiel endete, sowie Version und Einstellungen des Spiels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each game session: frame rate, frame and GPU times, stutters and what caused them, shader preparation, memory, heat and power, sound, the screen’s sizes, how the game ended, and the game’s version and settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada sesión de juego: fotogramas por segundo, tiempos de fotograma y de GPU, tirones y su causa, preparación de shaders, memoria, calor y consumo, sonido, los tamaños de pantalla, cómo terminó el juego, y la versión y los ajustes del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque partie : images par seconde, temps d’image et du GPU, saccades et leurs causes, préparation des shaders, mémoire, chaleur et énergie, son, tailles de l’écran, la façon dont le jeu s’est arrêté, la version du jeu et ses réglages."
          }
        }
      }
    },
    "telemetry.what.never" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie deine Apple-ID, den Namen deines iPhones, deine Dateien, die Adressen deines Speichers oder das Protokoll des Spiels selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never your Apple ID, your iPhone’s name, your files, the addresses of your storage or the game’s log itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca tu ID de Apple, el nombre de tu iPhone, tus archivos, las direcciones de tu almacenamiento ni el registro del juego en sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais votre identifiant Apple, le nom de votre iPhone, vos fichiers, les adresses de votre stockage ni le journal du jeu lui-même."
          }
        }
      }
    },
    "tv.captured" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm des iPhones wird aufgezeichnet oder auf einem anderen Bildschirm gezeigt, daher bleibt das Spiel verborgen."
          }
        },
        "en" : {
