          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google cerró la sesión de Cartouche en %@, como hace tras 7 días con un proyecto en pruebas: vuelve a iniciar sesión en Google en Sistema › Almacenamiento. Mientras tanto, tus juegos instalados funcionan y tus partidas guardadas esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google a mis fin à la connexion de Cartouche à %@, comme il le fait au bout de 7 jours pour un projet en test : reconnectez-vous à Google dans Système › Stockage. En attendant, vos jeux installés se lancent, et vos sauvegardes attendent."
          }
        }
      }
