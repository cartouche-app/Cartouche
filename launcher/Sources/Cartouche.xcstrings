    "guide.build.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative macht aus deiner eigenen Kopie eines Spiels eine App für das iPhone, auf einem Mac. Cartouche für Mac erledigt das auf deinem und erstellt deine Spiele erneut, wenn nxnative sie verbessert. Ohne Mac erstellt Cartouche Cloud es für dich, aus der Kopie, die du ihm sendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative turns your own copy of a game into an app for the iPhone, on a Mac. Cartouche for Mac does it on yours, and builds your games again when nxnative improves them. With no Mac, Cartouche Cloud builds it for you, from the copy you send it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative convierte tu propia copia de un juego en una app para el iPhone, en un Mac. Cartouche para Mac lo hace en el tuyo, y vuelve a compilar tus juegos cuando nxnative los mejora. Sin Mac, Cartouche Cloud lo compila por ti, a partir de la copia que le envías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative transforme votre propre copie d’un jeu en app pour l’iPhone, sur un Mac. Cartouche pour Mac s’en charge sur le vôtre, et reconstruit vos jeux quand nxnative les améliore. Sans Mac, Cartouche Cloud le construit pour vous, à partir de la copie que vous lui envoyez."
          }
        }
      }
    },
