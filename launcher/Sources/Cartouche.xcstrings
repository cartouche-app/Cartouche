    "storage.s3.keys.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel deines eigenen Accounts, die diesen Bucket lesen und beschreiben dürfen. Cartouche signiert jede Anfrage damit, bewahrt den geheimen Schlüssel im Schlüsselbund dieses iPhones auf und macht den Bucket nie öffentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys of your own account, allowed to read and write this bucket. Cartouche signs each request with them, keeps the secret key in this iPhone’s keychain, and never makes the bucket public."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claves de tu propia cuenta, con permiso para leer y escribir en este bucket. Cartouche firma cada solicitud con ellas, guarda la clave secreta en el llavero de este iPhone y nunca hace público el bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de votre propre compte, autorisées à lire et écrire dans ce bucket. Cartouche signe chaque requête avec elles, garde la clé secrète dans le trousseau de cet iPhone, et ne rend jamais le bucket public."
          }
        }
      }
    },
