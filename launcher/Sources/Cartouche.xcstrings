    "sideStore.pairing.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein SideStore hat die Kopplungsdatei dieses iPhones: Cartouche fragt ihn danach. SideStore öffnet sich kurz und bringt dich dann hierher zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your SideStore holds this iPhone’s pairing file: Cartouche asks it for it. SideStore opens for a moment, then brings you back here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu SideStore tiene el archivo de emparejamiento de este iPhone: Cartouche se lo pide. SideStore se abre un momento y luego te trae de vuelta aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre SideStore a le fichier de jumelage de cet iPhone : Cartouche le lui demande. SideStore s’ouvre un instant, puis vous ramène ici."
          }
        }
      }
    },
    "sideStore.pairing.noAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche konnte deinen SideStore nicht öffnen. Öffne SideStore einmal und versuche es erneut, oder wähle hier die Kopplungsdatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche could not open your SideStore. Open SideStore once, then try again, or choose the pairing file here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche no pudo abrir tu SideStore. Abre SideStore una vez y vuelve a intentarlo, o elige aquí el archivo de emparejamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche n’a pas pu ouvrir votre SideStore. Ouvrez SideStore une fois, puis réessayez, ou choisissez le fichier de jumelage ici."
          }
        }
      }
    },
    "sideStore.signIn.otherCertificate" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Apple-ID hat ein Zertifikat, das Cartouche nicht besitzt, und Cartouche widerruft es nie. Melde dich mit der Apple-ID an, die dein SideStore verwendet: Cartouche holt das Zertifikat, mit dem SideStore es signiert hat. Ist es diese, installiere Cartouche erneut aus deinem SideStore und melde dich dann erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple ID has a certificate that Cartouche does not hold, and Cartouche never revokes it. Sign in with the Apple ID your SideStore uses: Cartouche takes the certificate SideStore signed it with. If it is this one, install Cartouche again from your SideStore, then sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ID de Apple tiene un certificado que Cartouche no tiene, y Cartouche nunca lo revoca. Inicia sesión con el ID de Apple que usa tu SideStore: Cartouche obtiene el certificado con el que lo firmó SideStore. Si es este, vuelve a instalar Cartouche desde tu SideStore y vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet identifiant Apple a un certificat que Cartouche n’a pas, et Cartouche ne le révoque jamais. Connectez-vous avec l’identifiant Apple de votre SideStore : Cartouche reprend le certificat avec lequel SideStore l’a signé. Si c’est celui-ci, réinstallez Cartouche depuis votre SideStore, puis reconnectez-vous."
          }
        }
      }
    },
