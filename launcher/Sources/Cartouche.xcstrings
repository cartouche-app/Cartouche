            "state" : "translated",
            "value" : "%@ zeigt einen anderen Schlüssel als den, den Cartouche behalten hat, daher hat Cartouche dein Passwort nicht gesendet. Hast du den Server neu installiert, entferne ihn hier und füge ihn wieder hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ shows another key than the one Cartouche kept, so Cartouche did not send your password. If you reinstalled the server, remove it here and add it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muestra una clave distinta de la que guardó Cartouche, así que Cartouche no envió tu contraseña. Si reinstalaste el servidor, quítalo aquí y vuelve a añadirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ montre une autre clé que celle que Cartouche a gardée, donc Cartouche n’a pas envoyé votre mot de passe. Si vous avez réinstallé le serveur, supprimez-le ici et ajoutez-le à nouveau."
          }
        }
      }
    },
