    "gameLog.send.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche erhält Anfang und Ende jedes Protokolls, privat und bereinigt: ohne die Pfade deiner Ordner, Adressen, Namen oder Kennungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche receives the start and the end of each log, privately and cleaned: without the paths of your folders, addresses, names or identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche recibe el principio y el final de cada registro, en privado y limpio: sin las rutas de tus carpetas, direcciones, nombres ni identificadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche reçoit le début et la fin de chaque journal, en privé et nettoyés : sans les chemins de vos dossiers, ni adresses, ni noms, ni identifiants."
          }
        }
      }
    },
    "gameLog.sent.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in spitzen Klammern steht, etwa <path> oder <address>, ersetzt, was entfernt wurde. Der Server von Cartouche gibt den Rest privat an das Projekt weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is in angle brackets, such as <path> or <address>, stands for what was taken out. Cartouche’s server passes the rest to the project, privately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que está entre corchetes angulares, como <path> o <address>, sustituye a lo que se quitó. El servidor de Cartouche pasa el resto al proyecto, en privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est entre chevrons, comme <path> ou <address>, remplace ce qui a été retiré. Le serveur de Cartouche transmet le reste au projet, en privé."
          }
        }
      }
    },
