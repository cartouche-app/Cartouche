    "sideStore.memory.reinstall" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein SideStore hat es mit einer kostenlosen Apple-ID weggelassen: Ohne es gibt iOS Cartouche und seinen Spielen etwa 3 GB. Cartouche installiert sich einmal neu, von sich selbst signiert, und bekommt es so. Danach geht es zum Home-Bildschirm: Öffne es wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your SideStore left it out with a free Apple ID: without it, iOS gives Cartouche and its games about 3 GB. Cartouche installs itself again, once, signed by itself, which gets it. It then goes to the home screen: open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu SideStore la dejó fuera con un ID de Apple gratuito: sin ella, iOS da unos 3 GB a Cartouche y a sus juegos. Cartouche se vuelve a instalar, una vez, firmado por sí mismo, lo que la obtiene. Luego va a la pantalla de inicio: vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre SideStore l’a laissée de côté avec un identifiant Apple gratuit : sans elle, iOS donne environ 3 Go à Cartouche et à ses jeux. Cartouche s’installe à nouveau, une fois, signé par lui-même, ce qui la lui donne. Il passe ensuite à l’écran d’accueil : rouvrez-le."
          }
        }
      }
    },
