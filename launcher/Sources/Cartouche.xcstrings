    "system.playing.controller.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der letzte Controller während eines Spiels getrennt wird, pausiert das Spiel 3 Sekunden später und die Konsole erscheint. Ein wieder verbundener Controller setzt es fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the last controller disconnects during a game, the game pauses 3 seconds later and the console shows. A controller connected again brings it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el último mando se desconecta durante una partida, el juego se pone en pausa 3 segundos después y aparece la consola. Un mando conectado de nuevo lo reanuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la dernière manette se déconnecte en pleine partie, le jeu se met en pause 3 secondes plus tard et la console s’affiche. Une manette reconnectée le relance."
          }
        }
      }
    },
    "system.playing.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Home-Taste über dem Spiel oder die des Controllers holt die Konsole zurück und pausiert das Spiel. Ein Spiel, das mehr Arbeitsspeicher braucht, als es hier hat, startet anstelle von Cartouche, wenn Cartouche mehr hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Home button over the game, or the controller’s, brings back the console and pauses the game. A game that needs more memory than it has here starts in Cartouche’s place, when Cartouche has more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón de inicio sobre el juego, o el del mando, trae de vuelta la consola y pone el juego en pausa. Un juego que necesita más memoria de la que tiene aquí se inicia en lugar de Cartouche, cuando Cartouche tiene más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Home sur le jeu, ou celui de la manette, ramène la console et met le jeu en pause. Un jeu qui demande plus de mémoire qu’il n’en a ici démarre à la place de Cartouche, si Cartouche en a plus."
          }
        }
      }
    },
