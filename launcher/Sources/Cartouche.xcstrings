    "shortcuts.siri.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri braucht den Namen von Cartouche im Satz. Um nur den Namen des Spiels zu sagen, gib ihn unten einem Kurzbefehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri needs Cartouche’s name in the sentence. To say the game’s name alone, give it to a shortcut, below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri necesita el nombre de Cartouche en la frase. Para decir solo el nombre del juego, dáselo a un atajo, abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri a besoin du nom de Cartouche dans la phrase. Pour ne dire que le nom du jeu, donnez-le à un raccourci, ci-dessous."
          }
        }
      }
    },
    "shortcuts.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in Kurzbefehle auf +, um einen neuen Kurzbefehl zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Shortcuts, tap + to make a new shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Atajos, toca + para crear un atajo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Raccourcis, touchez + pour créer un raccourci."
          }
        }
      }
    },
    "shortcuts.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Aktion hinzufügen“, suche nach Cartouche und wähle „Spiel starten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Add Action, search for Cartouche, and choose Play a Game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Añadir acción, busca Cartouche y elige Jugar a un juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Ajouter une action, cherchez Cartouche et choisissez Lancer un jeu."
          }
        }
      }
    },
    "shortcuts.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Spiel“ und wähle %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Game, then choose %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Juego y elige %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Jeu, puis choisissez %@."
          }
        }
      }
    },
    "shortcuts.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben auf den Namen des Kurzbefehls und benenne ihn so um, wie du ihn zu Siri sagen wirst, etwa „%@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the shortcut’s name at the top and rename it as you will say it to Siri, such as “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre del atajo arriba y cámbialo por como se lo dirás a Siri, por ejemplo “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le nom du raccourci en haut et renommez-le comme vous le direz à Siri, par exemple « %@ »."
          }
        }
      }
    },
    "shortcuts.step5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Taste „Teilen“ und dann auf „Zum Home-Bildschirm“. Sein Symbol startet das Spiel wie „Spielen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the Share button, then Add to Home Screen. Its icon starts the game as Play does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón Compartir y luego Añadir a pantalla de inicio. Su icono inicia el juego como Jugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton Partager, puis Sur l’écran d’accueil. Son icône lance le jeu comme Jouer."
          }
        }
      }
    },
    "shortcuts.title" : {
