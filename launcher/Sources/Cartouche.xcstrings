    "work.transfer.advice.tailnet" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist langsam: Über Tailscale geht das Spiel durchs Internet. Zu Hause, im selben WLAN oder per Kabel, kommt es viel schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is slow: through Tailscale, the game goes over the internet. At home, on the same Wi-Fi or by cable, it comes much faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va lento: a través de Tailscale, el juego pasa por internet. En casa, en la misma red Wi-Fi o por cable, llegará mucho más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est lent : par Tailscale, le jeu passe par internet. À la maison, sur le même Wi-Fi ou par câble, il arrivera bien plus vite."
          }
        }
      }
    },
