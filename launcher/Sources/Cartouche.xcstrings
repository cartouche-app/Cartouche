          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil erlaubt die Schlüsselbundgruppen der Spiele nicht: Die Spiele teilen sich den Schlüsselbund von Cartouche. Die meisten Spiele nutzen ihn nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile does not allow the games’ keychain groups: the games share Cartouche’s keychain. Most games do not use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil no permite los grupos de llaveros de los juegos: los juegos comparten el llavero de Cartouche. La mayoría de los juegos no lo usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil ne permet pas les groupes de trousseau des jeux : les jeux partagent le trousseau de Cartouche. La plupart des jeux ne s’en servent pas."
          }
        }
      }
    },
    "signature.memory.leftOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Signier-App hat das erhöhte Speicherlimit weggelassen, das dein Profil erlaubt: Ohne es gibt iOS Cartouche und seinen Spielen etwa 3 GB. Signiere Cartouche erneut und behalte dabei alle Berechtigungen des Profils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your signing app left out Increased Memory Limit, which your profile allows: without it, iOS gives Cartouche and its games about 3 GB. Sign Cartouche again, keeping every entitlement of the profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu app de firma dejó fuera la memoria ampliada, que tu perfil permite: sin ella, iOS da unos 3 GB a Cartouche y a sus juegos. Vuelve a firmar Cartouche conservando todas las capacidades del perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre app de signature a laissé de côté la mémoire augmentée, que votre profil permet : sans elle, iOS donne environ 3 Go à Cartouche et à ses jeux. Signez Cartouche à nouveau en gardant tous les droits du profil."
          }
        }
      }
    },
    "signature.memory.notInProfile" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil erlaubt das erhöhte Speicherlimit nicht: Ohne es gibt iOS Cartouche und seinen Spielen etwa 3 GB, zu wenig für die meisten Spiele. Verwende ein Profil, dessen App-ID diese Fähigkeit hat, und signiere Cartouche dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile does not allow Increased Memory Limit: without it, iOS gives Cartouche and its games about 3 GB, too little for most games. Use a profile whose App ID has this capability, then sign Cartouche again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil no permite la memoria ampliada: sin ella, iOS da unos 3 GB a Cartouche y a sus juegos, demasiado poco para la mayoría de los juegos. Usa un perfil cuyo App ID tenga esta capacidad y vuelve a firmar Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil ne permet pas la mémoire augmentée : sans elle, iOS donne environ 3 Go à Cartouche et à ses jeux, trop peu pour la plupart des jeux. Prenez un profil dont l’App ID a cette capacité, puis signez Cartouche à nouveau."
          }
        }
      }
    },
