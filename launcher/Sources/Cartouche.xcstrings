    "signIn.tooManyRequests" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lehnt vorerst neue Anmeldungen ab: zu viele Versuche in kurzer Zeit, von dieser Apple-ID oder aus diesem Netzwerk. Es gibt nichts zurückzusetzen oder neu zu installieren. Warte, bis der Countdown abgelaufen ist, und melde dich dann erneut an: Ein früherer Versuch kann die Wartezeit verlängern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple is refusing new sign-ins for now: too many attempts in a short time, from this Apple ID or from this network. There is nothing to reset or reinstall. Wait for the countdown to end, then sign in again: trying sooner can make the wait longer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple rechaza nuevos inicios de sesión por ahora: demasiados intentos en poco tiempo, desde este ID de Apple o desde esta red. No hay nada que restablecer ni reinstalar. Espera a que termine la cuenta atrás y vuelve a iniciar sesión: intentarlo antes puede alargar la espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple refuse de nouvelles connexions pour l’instant : trop de tentatives en peu de temps, pour cet identifiant Apple ou depuis ce réseau. Il n’y a rien à réinitialiser ni à réinstaller. Attendez la fin du compte à rebours, puis reconnectez-vous : réessayer plus tôt peut allonger l’attente."
          }
        }
      }
    },
    "signIn.unavailable" : {
