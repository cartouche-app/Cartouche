    "system.signature.renew.revoked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat das Zertifikat widerrufen, mit dem Cartouche signiert ist, höchstwahrscheinlich weil eine andere App oder ein anderer Computer mit derselben Apple-ID ein neues geholt hat. Cartouche kann sich mit diesem Zertifikat weder erneuern noch aktualisieren: Installiere Cartouche mit dem Cartouche-Installer auf deinem Computer erneut über diese Kopie, mit derselben Apple-ID. Deine Spiele und Spielstände bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple revoked the certificate Cartouche is signed with, most likely because another app or computer took a new one with the same Apple ID. Cartouche can no longer renew or update itself with this certificate: install Cartouche again over this copy with the Cartouche Installer, on your computer, with the same Apple ID. Your games and saves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple revocó el certificado con el que está firmado Cartouche, muy probablemente porque otra app u otro ordenador obtuvo uno nuevo con el mismo ID de Apple. Cartouche ya no puede renovarse ni actualizarse con este certificado: vuelve a instalar Cartouche sobre esta copia con el Instalador de Cartouche, en tu ordenador, con el mismo ID de Apple. Tus juegos y tus partidas guardadas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a révoqué le certificat qui signe Cartouche, sans doute parce qu’une autre app ou un autre ordinateur en a pris un nouveau avec le même identifiant Apple. Cartouche ne peut plus se renouveler ni se mettre à jour avec ce certificat : réinstallez Cartouche par-dessus cette copie avec l’Installeur Cartouche, sur votre ordinateur, avec le même identifiant Apple. Vos jeux et vos sauvegardes restent."
          }
        }
      }
    },
    "system.signature.renew.sessionExpired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple meldet, dass die Sitzung deiner Apple-ID abgelaufen ist: Cartouche kann sich weder erneuern noch aktualisieren, bis du dich erneut anmeldest. Wähle „Erneut anmelden“ auf der Seite „System“, mit derselben Apple-ID: Danach erneuert sich Cartouche. Deine Spiele und Spielstände bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple says the session of your Apple ID has expired: Cartouche can no longer renew or update itself until you sign in again. Choose Sign in again, on the System page, with the same Apple ID: Cartouche then renews itself. Your games and saves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dice que la sesión de tu ID de Apple ha caducado: Cartouche ya no puede renovarse ni actualizarse hasta que vuelvas a iniciar sesión. Elige Volver a iniciar sesión, en la página Sistema, con el mismo ID de Apple: Cartouche se renovará entonces. Tus juegos y tus partidas guardadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dit que la session de votre identifiant Apple a expiré : Cartouche ne peut plus se renouveler ni se mettre à jour tant que vous ne vous reconnectez pas. Choisissez Se reconnecter, sur la page Système, avec le même identifiant Apple : Cartouche se renouvelle ensuite. Vos jeux et vos sauvegardes restent."
          }
        }
      }
    },
