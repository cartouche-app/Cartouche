    "storage.saves.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche hält die Spielstände deiner Spiele mit diesem Ordner synchron, ein Ordner pro Spiel: Sie kommen, wenn ein Spiel installiert wird und bevor es startet, etwa nachdem ein anderes iPhone es gespielt hat oder Cartouche neu installiert wurde, und gehen ein paar Sekunden nach jedem Speichern des Spiels dorthin, spätestens nach dem Spiel. Die %lld neuesten Kopien werden behalten, eine für jede gespielte Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche keeps your games’ saves in step with this folder, a folder per game: they come when a game is installed and before it starts, as after another iPhone played it or Cartouche was installed again, and go a few seconds after each save of the game, after the game at the latest. The %lld newest copies are kept, one for each game played."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche mantiene las partidas guardadas de tus juegos al compás de esta carpeta, una carpeta por juego: llegan cuando se instala un juego y antes de que arranque, como después de que otro iPhone lo jugara o de volver a instalar Cartouche, y van allí unos segundos después de cada guardado del juego, como muy tarde tras la partida. Se conservan las %lld copias más recientes, una por cada partida jugada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche synchronise les sauvegardes de vos jeux avec ce dossier, un dossier par jeu : elles arrivent à l’installation d’un jeu et avant chaque lancement, comme après une partie sur un autre iPhone ou une réinstallation de Cartouche, et y repartent quelques secondes après chaque sauvegarde du jeu, au plus tard après la partie. Les %lld copies les plus récentes sont gardées, une par partie."
          }
        }
      }
    },
    "storage.servers" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
