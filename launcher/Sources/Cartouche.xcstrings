    "reason.gpu" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spiele von nxnative brauchen ein iPhone 15 Pro oder neuer oder ein iPad mit M1 Chip oder neuer: Die GPU dieses iPhones kann ihre komprimierten Texturen nicht lesen, und ein Spiel hält dort vor seinem ersten Bild an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nxnative’s games need an iPhone 15 Pro or later, or an iPad with an M1 chip or later: this iPhone’s GPU cannot read their compressed textures, and a game stops there before its first image."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los juegos de nxnative necesitan un iPhone 15 Pro o posterior, o un iPad con chip M1 o posterior: la GPU de este iPhone no puede leer sus texturas comprimidas, y un juego se detiene ahí antes de su primera imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux nxnative demandent un iPhone 15 Pro ou plus récent, ou un iPad avec une puce M1 ou plus récente : le GPU de cet iPhone ne lit pas leurs textures compressées, et un jeu s’y arrête avant sa première image."
          }
        }
      }
    },
