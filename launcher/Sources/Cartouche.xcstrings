    "system.signature.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche erneuert sich jedes Mal, wenn du es in seinen letzten 3 Tagen öffnest, und verbindet dafür LocalDevVPN. Einmal abgelaufen, öffnet es sich nicht mehr: Installiere es erneut mit dem Cartouche-Installer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche renews itself each time you open it in its last 3 days, and connects LocalDevVPN for it. Once expired, it no longer opens: install it again with the Cartouche Installer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche se renueva cada vez que lo abres en sus últimos 3 días, y conecta LocalDevVPN para ello. Una vez caducado, ya no se abre: vuelve a instalarlo con el Instalador de Cartouche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche se renouvelle seul chaque fois que vous l’ouvrez dans ses 3 derniers jours, et connecte LocalDevVPN pour cela. Expiré, il ne s’ouvre plus : réinstallez-le avec l’Installeur Cartouche."
          }
        }
      }
    },
