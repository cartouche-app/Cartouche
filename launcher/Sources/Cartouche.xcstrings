    "signIn.device.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat deine Apple-ID akzeptiert. Cartouche muss dieses iPhone nur noch damit registrieren, über LocalDevVPN: kein Passwort, kein Code."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple accepted your Apple ID. Cartouche only has to register this iPhone with it, through LocalDevVPN: no password, no code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
